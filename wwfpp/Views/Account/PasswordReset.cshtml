@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model PasswordResetRequestViewModel;
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "| Reset Password";

    var msg_please_wait = "";
    var resetpassword = @TempData["msg"] as string;
    var Id = @TempData["Id"];
    var user_id = @TempData["user_id"];
    var token = @TempData["Token"];
    var msgPasswordAlreadyUsed = @TempData["msgPasswordAlreadyUsed"];
    var UserName = @TempData["UserName"];
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}

<form name="frm" id="frm" onsubmit="return false">
    @Html.AntiForgeryToken()
    <div id="wrapper">
        <div id="main-login">
            <div id="center">
                <div id="message_header-1"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
                <div id="message_header">@Html.Raw(ShowMsg)</div>

                <div id="divResetForgotPre">
                    @if (string.Equals(resetpassword, "ResetPassword", StringComparison.OrdinalIgnoreCase))
                    {
                        <div id="message_header-2"><p id="note" class="note">Please enter your details below to reset password.<br>@Lang.Password_policy</p></div>
                    }
                    else
                    {
                        <div id="message_header-2"><p id="note" class="error">
                                @Lang.msg_pwd_reset_expired
                            </p>
                        </div>
                    }
                    <div id="login-box-1"><img src=@Url.Content("~/images/logo-big.gif") width="197" height="203" /></div>
                    <div id="login-box-3">
                        <h2>Reset Password</h2>
                        @if (!string.IsNullOrWhiteSpace(resetpassword) && string.Equals(resetpassword, "ResetPassword", StringComparison.OrdinalIgnoreCase))
                    {
                            <h3>User Name:&nbsp;
                                @Html.TextBox("txtun", @UserName, new { @class = "textarea-login", maxlength = "20", @readonly = "readonly", style = "width:150px;" })
                                @Html.Hidden("Id", @Id)
                                @Html.Hidden("user_id", @user_id)
                                @Html.Hidden("tk", @token)
                            </h3>
                            <h3>New Password:&nbsp;@Html.TextBox("npwd", null, new { @class = "textarea-login", maxlength = "20", style = "width:150px;" })</h3>
                            <h3>Retype Password:&nbsp;@Html.TextBox("cpwd", null, new { @class = "textarea-login", maxlength = "20", style = "width:150px;" })</h3>
                        <div>
                            <div id="divCaptcha">
                                <h3>
                                    <img name="cvscaptcha" id="cvscaptcha" width="200" height="50" style="border:1px solid #000;" src="@Url.Action("GenerateCaptcha", "Account")"><br/>
                                    Captcha: [ <a href="#" id="refreshCaptcha" title="Can't read the image? Click to generate new one."><font size="3">&#x21bb;</font></a> ]
                                    @Html.TextBox("txtcaptcha", null, new { @class = "textbox", maxlength = "6", style = "width:50px;" })
                                </h3>
                            </div>
                        </div>
                        <div>
                                <h3><span id="password_strength_color"></span>&nbsp;<span id="password_strength_text">&nbsp;</span> - <span id="pwd_validity" class="red"></span><span id="pwd_con_validity" class="red"></span></h3>
                        </div>
                        <div>
                            <h4>
                                    <button type="button" class="login-button" name="btnResetPa" id="btnResetPa">Update</button>
                            </h4>
                        </div>                        
                    }
                    else
                    {
                        <div>
                            <h4>
                                    <button type="button" class="login-button-4" name="btnreturnlogin" id="btnreturnlogin" data-url="@Url.Action("Login", "Account")">Login</button>
                                    <button type="button" class="login-button-4" name="btnforpass" id="btnforpass" data-url="@Url.Action("PasswordForgot", "Account")">Forgot Password</button>
                            </h4>
                        </div>
                    }

                    </div>
                </div>

                <div id="divResetForgotPos" class="displaynone">
                    <div id="message_header-2">
                        <p id="note" class="success">
                            @Lang.msg_suc_forgot_password
                        </p>
                    </div>
                    <div id="login-box-1"><img src=@Url.Content("~/images/logo-big.gif") width="197" height="203" /></div>
                    <div id="login-box-3">
                        <h2>Reset Password</h2>
                        <div>
                            <h4>
                                <button type="button" class="login-button-4" name="btnreturnlogin" id="btnreturnlogin" data-url="@Url.Action("Login", "Account")">Login</button>
                            </h4>
                        </div>
                    </div>
                </div>

            </div><!-- center -->
        </div><!-- main-login -->
    </div><!-- wrapper -->

</form>
<script>
    var postforwardurl = '@Url.Action("PasswordReset", "Account")';
    document.addEventListener("DOMContentLoaded", function () {const npwd = document.getElementById("npwd");if (npwd) {npwd.addEventListener("keyup", function (e) {e.preventDefault();CheckPasswordStrength(e.target.value);checkPassword('npwd');checkCPassword('npwd','cpwd');});}});
    document.addEventListener("DOMContentLoaded", function () {const cpwd = document.getElementById("cpwd");if (cpwd) {cpwd.addEventListener("keyup", function (e) {e.preventDefault();checkCPassword('npwd','cpwd');});}});
    document.addEventListener("DOMContentLoaded", function () {const btnforpass = document.getElementById("btnforpass");if (btnforpass) {btnforpass.addEventListener("click", function (e) {e.preventDefault();top.location.href = btnforpass.dataset.url;});}});
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src=@Url.Content("~/js/Account/passwordreset-MzmLIaJMJu.js") defer></script>
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model LoginMFAViewModel;
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "| Login - Multi Factor Authentication";
    var msg_please_wait = "";    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*invalidlogin|error'*/
    var TempUserId = @TempData["UserId"];
    var UserName = @TempData["Username"];
}
<form name="frm" id="frm" onsubmit="return false">
    @Html.AntiForgeryToken()
    <div id="wrapper" >
        <div id="main-login" >
            <div id="center" >
                <div id="message_header-1"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
                <div id="message_header">@Html.Raw(ShowMsg)</div>
                <div id="message_header-2"><p id="note" class="note">Please enter your Pin to login.</p></div>
                <div id="login-box-1"><img src=@Url.Content("~/images/logo-big.gif") width="197" height="203" /></div>
                <div id="login-box-3">
                    <h2>Login - Multi Factor Authentication @Html.Hidden("txtUId", @TempUserId)</h2>
                    <h3>User Name:&nbsp;@Html.TextBox("txtun", @UserName, new { @class = "textarea-login", maxlength = "20", @readonly = "readonly" })</h3>
                    <h3>Pin:&nbsp;@Html.Password("txtpw", null, new { @class = "textarea-login", maxlength = "6", style = "width:150px;" })</h3>
                    <h4>
                        <button type="button" class="login-button" name="btnlogin" id="btnlogin">Login</button>
                    </h4>
                </div>
            </div><!-- center -->
        </div><!-- main-login -->
    </div><!-- wrapper -->
</form>
<script>
    var postforwardurl = '@Url.Action("LoginMultiFactor", "Account")';
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src=@Url.Content("~/js/Account/loginmultifactor-jmRXlkwju.js") defer></script>
}
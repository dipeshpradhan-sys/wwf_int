@model ApprovalFromEmailVM

@if (!string.IsNullOrWhiteSpace(@ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.ErrorMessage
    </div>
}
else
{
    <h1>@ViewBag.HeaderMessage</h1>
    <div id="ModalForm">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.EmpID) <!-- Needed for Edit -->
        @Html.HiddenFor(m => m.AppID)
        @Html.HiddenFor(m => m.ToID)
        @Html.HiddenFor(m => m.ToEmpID)
        @Html.HiddenFor(m => m.St)
        @Html.HiddenFor(m => m.Counter)
        @Html.HiddenFor(m => m.Month)
        @Html.HiddenFor(m => m.Year)
        @Html.HiddenFor(m => m.ApproveFor)
        @Html.HiddenFor(m => m.Token)

        <div class="form-group row p-1">
            <label class="col-sm-4 col-form-label"><h5>Description</h5></label>
            <div class="col-sm-8">
                <div class="input-group input-group-sm">
                    <textarea asp-for="Description" rows="5" cols="50" class="form-control" placeholder="Enter Description"></textarea>
                </div>
            </div>
        </div>
        <div>
            <input id="send-to-me-action" type="button" value="@ViewBag.ApproveDeclineRecommend">
        </div>
    </div>


    @section Scripts {
        <script>
            $(document).on("click", "#send-to-me-action", function () {

                const empId = $('#EmpID').val();
                const appId = $('#AppID').val();
                const month = $('#Month').val();
                const year = $('#Year').val();
                const toID = $('#ToID').val();
                const toEmpID = $('#ToEmpID').val();
                const st = $('#St').val();
                const counter = $('#Counter').val();
                const approveFor = $('#ApproveFor').val();
                const token = $('#Token').val();
                const Description = $('#Description').val();

                $.ajax({
                    url: "/EmailApproval/EmailApprovalSave",
                    type: "POST",
                    data: {empId,appId,month,year,toID,toEmpID,st,counter,approveFor,token,Description},
                    success: function (data) {
                        alert(data.message);
                    },
            error: function (xhr, status, error) {

                console.log("Status:", xhr.status);
                console.log("Status Text:", xhr.statusText);
                console.log("Response:", xhr.responseText);

                alert(xhr.responseText);
            }
                });
            });
        </script>
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panda Pays @ViewData["Title"]</title>
    <link rel="stylesheet" href=@Url.Content("~/lib/bootstrap/dist/css/bootstrap.min.css") />
    <link rel="stylesheet" href=@Url.Content("~/css/site.css") asp-append-version="true" />
</head>
<body>
    <header class="text-white">
        <div id="top">
            <div id="curve-left"></div>
            <div id="logo-01">
                <div id="top-nav-1"></div>
            </div>

            <div id="curve-right">
                <div id="header-txt">&nbsp;</div>
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-center">
        <div class="container">
            &nbsp;
        </div>
    </footer>
    @RenderSection("Scripts", required: false)
</body>
</html>

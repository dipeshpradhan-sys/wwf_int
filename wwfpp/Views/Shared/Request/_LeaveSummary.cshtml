@model LeaveBalanceListViewModel

<style>
    /* Grid-like table styling */
    .leave-table {
        width: 100%;
        border-collapse: collapse;
    }

        .leave-table th, .leave-table td {
            border: 1px solid #ccc;
            padding: 6px;
        }

        .leave-table th {
            background-color: #f2f2f2;
            font-weight: bold;
            text-align: left;
        }

    /* Section header (Annual Leave, Sick Leave, etc.) */
    .leave-section {
        background-color: #d9edf7; /* light blue */
        font-weight: bold;
    }

    /* Highlight Total and Balance rows */
    .leave-total, .leave-balance {
        font-weight: bold;
        background-color: #f9f9f9;
    }
</style>

<table class="leave-table">
    <thead>
        <tr>
            <th width="20%">Description</th>
            <th width="10%">Hours</th>
            <th width="60%">Days</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var leave in Model.LeaveBalances)
        {
            <!-- Section header -->
            <tr class="leave-section">
                <td colspan="3">@leave.Description</td>
            </tr>

            @if (leave.CarryForward > 0)
            {
                <tr>
                    <td>Carry Forward</td>
                    <td>@leave.CarryForward</td>
                    <td></td>
                </tr>
            }

            @if (leave.Current > 0)
            {
                <tr>
                    <td>Current</td>
                    <td>@leave.Current</td>
                    <td></td>
                </tr>
            }

            <!-- Total row -->
            <tr class="leave-total">
                <td>Total</td>
                <td>@leave.Total</td>
                <td></td>
            </tr>

            <tr>
                <td>Taken</td>
                <td>@leave.TakenHours</td>
                <td>@leave.TakenDays</td>
            </tr>

            <!-- Balance row -->
            <tr class="leave-balance">
                <td>Balance</td>
                <td>@leave.BalanceHours.ToString("F2")</td>
                <td>@leave.BalanceDays.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>

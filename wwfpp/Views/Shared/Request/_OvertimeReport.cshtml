@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Overtime Report";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());

}
@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>



<!-- Controls row under the header -->
<div class="p-0 bg-white rounded mb-3">
    <!-- First row: filters -->
    <div class="row align-items-center mt-2">
        <div class="col-auto">
            @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter,
                new { @class = "form-select me-4", style = "width:150px;" })
        </div>
        <div class="col-auto">
            @Html.DropDownList("EmployeeFilter", (SelectList)ViewBag.EmployeeFilter,
                new { @class = "form-select", style = "width:300px;" })
        </div>
        <div class="col-auto">
            @Html.DropDownList("StatusPaidApprovedFilter", (SelectList)ViewBag.StatusPaidApprovedFilter,
                    new { @class = "form-select", style = "width:300px;" })
        </div>
    </div>

    <!-- Second row: Start & End Date in same column -->
    <div class="row align-items-center mt-2">
        <div class="col-auto">
            Start Date:
            @Html.TextBox("date_from", null, new
                {
                    @class = "form-control form-control-sm",
                    @id = "date_from",
                    autocomplete = "off"
                })
        </div>
        <div class="col-auto">
            End Date:
            @Html.TextBox("date_to", null, new
                {
                    @class = "form-control form-control-sm",
                    @id = "date_to",
                    autocomplete = "off"
                })

            <!-- Export button directly below -->
        </div>
        <div class="mt-2">
            <button id="BtnExport" class="button bg-green">
                Export to Excel
            </button>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Initialize datepickers
        $('#date_from').datepicker({
            format: 'mm/dd/yyyy',
            autoclose: true,
            todayHighlight: true,
            todayBtn: "linked",
            clearBtn: true
        });

        $('#date_to').datepicker({
            format: 'mm/dd/yyyy',
            autoclose: true,
            todayHighlight: true,
            todayBtn: "linked",
            clearBtn: true
        });

        $("#StatusFilter").off("change").on("change", function () {
            const statusV = $(this).val();
            var ddl = $('#EmployeeFilter');
            ddl.empty();

            // Add placeholder option depending on status
            if (statusV === "A") {
                ddl.append('<option value="">-- Select Active Employee --</option>');
            } else {
                ddl.append('<option value="">-- Select Inactive Employee --</option>');
            }
            // Reset selected value
            ddl.val('');

            // Reload employees via AJAX
            $.getJSON('/Employee/GetEmployeesByStatus', { status: statusV }, function (data) {
                $.each(data, function (i, emp) {
                    ddl.append($('<option>', {
                        value: emp.value,   // ✅ must match property name from JSON
                        text: emp.text
                    }));
                });
            });
            table.draw();
        });

        $(document).off("click", "#BtnExport").on("click", "#BtnExport", function() {
            var ReportType = $("#StatusPaidApprovedFilter").val();
            var Status = $("#StatusFilter").val();
            var Employee = $("#EmployeeFilter").val();
            var StartDate = $("#date_from").val();
            var EndDate = $("#date_to").val();

            // Validation
            if (!ReportType) {
                $('#message_header')
                    .html('<p id="message" class="error">Please select report type.</p>')
                    .css('height', '50px')
                    .show();
                return false;
            }
            if (!Status) {
                $('#message_header')
                    .html('<p id="message" class="error">Please select status.</p>')
                    .css('height', '50px')
                    .show();
                return false;
            }
            if (!StartDate) {
                $('#message_header')
                    .html('<p id="message" class="error">Please enter start date.</p>')
                    .css('height', '50px')
                    .show();
                return false;
            }
            if (!EndDate) {
                $('#message_header')
                    .html('<p id="message" class="error">Please enter end date.</p>')
                    .css('height', '50px')
                    .show();
                return false;
            }

            $.ajax({
                url: '/Request/OvertimeReportGenerate',
                type: 'POST',
                data: {
                    ReportType: ReportType,
                    Status: Status,
                    Employee: Employee,
                    startDate: StartDate,
                    endDate: EndDate,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(res) {
                    if (res.status === "success") {
                        // Create download link dynamically
                        var link = document.createElement('a');
                        link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + res.fileContent;
                        link.download = res.fileName;
                        link.click();

                        $('#message').removeClass().addClass('success').html(msg_data_exported_success).show();
                    } else {
                        $('#message').removeClass().addClass('error').html(err_in_process + res.error).show();
                    }
                },
                error: function(xhr, status, error) {
                    $('#message').removeClass().addClass('error').html(err_in_process + error).show();
                }
            });
        });


    </script>
}


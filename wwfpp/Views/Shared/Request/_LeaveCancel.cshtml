@model wwfpp.Models.EmployeeLeaveViewModel
@{
    string? DATE_FORMAT = ViewBag.DATE_FORMAT;
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
    @Html.HiddenFor(m => m.id)
    @Html.Hidden("mode", "")
<div class="form-group row p-1">
    <div class="col-lg-12 mb-2">
        <strong>Employee:</strong> @ViewBag.EmployeeNameAndStatus
        @Html.HiddenFor(m => m.emp_id)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Leave:</strong> @Model.leave_type_name
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Start Date:</strong> @Model.leave_from_date?.ToString(DATE_FORMAT)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>End Date:</strong> @Model.leave_to_date?.ToString(DATE_FORMAT)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Leave in Hours:</strong> @Model.leave_in_hrs
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Description:</strong> @Model.leave_desc
    </div>

    <hr />

    <div class="col-lg-12 mb-2">
        <strong>Status:</strong> @Model.app_status
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Approved By:</strong> @Model.app_by_name
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Date:</strong> @Model.app_date?.ToString(DATE_FORMAT)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Remarks:</strong> @Model.app_remarks
    </div>
    <hr />

    <div class="col-lg-12 mb-2">
        <strong>Reason for Cancellation:<span class="text-danger">*</span></strong> @Html.TextAreaFor(m => m.can_remarks, new { @class = "form-control", rows = "3", cols = "50", maxlength = "250" })
    </div>
</div>

@if (ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
    <script>renderModalDiscardButton("modal-button-list", "Discard");</script>
}

    <script>    
    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") { $("#ModalID .modal-title").text("Update"); btn.text("Update"); $("#btnC").text("Cancel"); return; }
        if (btn.text() === "Update" || btn.text() === "Save") {
        if (checkInput('txt', 'can_remarks', 'Reason for cancellation is required.', 'modal-message') == false) { return false; }
            $("#mode").val("");
            $("#mode").val("cancel");
            submitSaveUpdate("/Request/LeaveCancel");
        }
    });
    $(document).off("click", "#btnDiscard").on("click", "#btnDiscard", function () {
        var btn = $(this);
        if (btn.text() === "Discard") {
            if (checkInput('txt', 'can_remarks', 'Reason for discard is required.', 'modal-message') == false) { return false; }
            $("#mode").val("");
            $("#mode").val("discard");
            submitSaveUpdate("/Request/LeaveDiscard");
        }
    });

    </script>


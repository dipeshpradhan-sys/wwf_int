@model wwfpp.Models.Request.EmployeeTravelMainViewModel
@{
    string? DATE_FORMAT = ViewBag.DATE_FORMAT;
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
@Html.HiddenFor(m => m.id)
    @Html.Hidden("mode", "")
<div class="form-group row p-1">
    <div class="col-lg-12 mb-2">
        <strong>Employee:</strong> @ViewBag.EmployeeNameAndStatus
        @Html.HiddenFor(m => m.emp_id)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Travel Type:</strong> @Model.TravelType
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Purpose of Trip:</strong> @Model.TripPurpose
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Destination/s:</strong> @Model.Destinations
    </div>

    <div class="col-lg-12 mb-2">
        <strong>Start Date:</strong> @Model.DateFrom?.ToString(DATE_FORMAT)
    </div>

    <div class="col-lg-12 mb-2">
        <strong>End Date:</strong> @Model.DateTo?.ToString(DATE_FORMAT)
    </div>

    @if (Model.i_app_status != "") {
        <hr />
        <div class="col-lg-12 mb-2">
            <strong>Recommended/Declined:</strong>
        </div>

        <div class="col-lg-12 mb-2">
            <strong>I.S. / L.D. Status:</strong> @Model.i_app_status
        </div>
            
        @if (Model.i_app_status == "Approved" || Model.i_app_status == "Declined")
        {
            <div class="col-lg-12 mb-2">
                <strong>Approved/Declined By:</strong> @Model.i_app_by_name
            </div>

            <div class="col-lg-12 mb-2">
                <strong>Date:</strong> @Model.i_app_date?.ToString(DATE_FORMAT)
            </div>
            @if (!string.IsNullOrEmpty(Model.rec_remarks))
            {
                <div class="col-lg-12 mb-2">
                    <strong>Remarks:</strong> @Model.rec_remarks
                </div>
            }
        }
    }
    <hr />
    <div class="col-lg-12 mb-2">
        <strong>Approved/Declined:</strong>
    </div>

    <div class="col-lg-12 mb-2">
        <strong>L.D. / C.R. Status:</strong> @Model.app_status
    </div>
    @if (Model.app_status == "Approved" || Model.app_status == "Declined")
    {
        <div class="col-lg-12 mb-2">
            <strong>Approved/Declined By:</strong> @Model.app_by_name
        </div>

        <div class="col-lg-12 mb-2">
            <strong>Date:</strong> @Model.app_date?.ToString(DATE_FORMAT)
        </div>
        @if (!string.IsNullOrEmpty(Model.app_remarks))
        {
            <div class="col-lg-12 mb-2">
                <strong>Remarks:</strong> @Model.app_remarks
            </div>
        }
    }
    <hr />
    <div class="col-lg-12 mb-2">
        <strong>Reason for Cancellation:<span class="text-danger">*</span></strong> @Html.TextAreaFor(m => m.can_remarks, new { @class = "form-control", rows = "3", cols = "50", maxlength = "250" })
    </div>
</div>

@if (ViewBag.apern == "true")
{
    @if (Model.can_by == null || Model.can_by == 0)
    {
        <script>renderModalButtons("modal-button-list", "Save");</script>
    }
    else
    {
        <script>renderModalDiscardButton("modal-button-list", "Discard");</script>
    }
}

    <script>    
    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") { $("#ModalID .modal-title").text("Update"); btn.text("Update"); $("#btnC").text("Cancel"); return; }
        if (btn.text() === "Update" || btn.text() === "Save") {
        if (checkInput('txt', 'can_remarks', 'Reason for cancellation is required.', 'modal-message') == false) { return false; }
            $("#mode").val("");
            $("#mode").val("cancel");
            submitSaveUpdate("/Request/TravelCancel");
        }
    });
    $(document).off("click", "#btnDiscard").on("click", "#btnDiscard", function() {
        var btn = $(this);
        if (btn.text() === "Discard") {
            if (checkInput('txt', 'can_remarks', 'Reason for discard is required.', 'modal-message') == false) { return false; }
            $("#mode").val("");
            $("#mode").val("discard");
            submitSaveUpdate("/Request/TravelDiscard");
        }
    });
    </script>


@using wwfpp.Services
@inject SettingsServices SettingsServices
@model wwfpp.Models.Request.EmployeeMedicalReimburseViewModel
@{
    string? mode = ViewBag.mode;
    string? DATE_FORMAT = ViewBag.DATE_FORMAT;
    string? bill_date = Model.BillDate.ToString();
    string? s_bill_date = SettingsServices.DateformatToDt(bill_date ?? string.Empty);
    string? cur_fiscal_year = Context.Session.GetString("fiscal_year");
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.FiscalYear)
    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Type <span class="text-danger">*</span></label>
        <div class="col-sm-4">
            @Html.DropDownListFor(m => m.ReimType,
                new SelectList(new[]
                {
                    new { Value = "", Text = "-- Select --" },
                    new { Value = "Medical", Text = "Medical" },
                    new { Value = "Life Insurance", Text = "Life Insurance" },
                    new { Value = "Non Life Insurance", Text = "Non Life Insurance" }
                }, "Value", "Text", Model.ReimType),
                new { @class = "form-control-sm", @id = "ReimType" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Marital Status <span class="text-danger">*</span></label>
        <div class="col-sm-4">
            <span class="form-control-plaintext">@Model.MaritalStatus</span>
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Bill Date <span class="text-danger">*</span></label>
        <div class="col-sm-4">
            @Html.TextBox("BillDate", s_bill_date, new { @class = "form-control", maxlength = "10" })
            <div class="col-lg-8"><button Type="button" id="btndate" name="btndate" class="button bg-sky">Date...</button></div>
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Ref. Number <span class="text-danger">*</span></label>
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.BillNo, new { @class = "form-control", @id = "BillNo" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Self Amount</label>
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.SelfAmt, new { @class = "form-control text-end", @id = "SelfAmt", type = "number", step = "0.01" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Spouse Amount</label>
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.SpouseAmt, new { @class = "form-control text-end", @id = "SpouseAmt", type = "number", step = "0.01" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Other Dependent Amount</label>
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.OtherDepAmt, new { @class = "form-control text-end", @id = "OtherDepAmt", type = "number", step = "0.01" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label text-end">Remarks</label>
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", @id = "Remarks", maxlength = "250" })
        </div>
    </div>

@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true" && Model.emp_status == "A" && Model.app_status != "Approved" && Model.app_status != "Declined" && Model.FiscalYear == cur_fiscal_year)
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}
<script>

    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") {$("#ModalID .modal-title").text("Update");btn.text("Update");$("#btnC").text("Cancel");return;}
        if (btn.text() === "Update" || btn.text() === "Save") {

            if ( checkInput( 'cmb', 'ReimType', 'Type is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'BillDate', 'Bill Date is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'BillNo', 'Ref.Number is required.', 'modal-message') == false ) {return false;}

            submitSaveUpdate("/Request/MedicalInsurance");
        }
    });
    $(document).off('blur', '#BillDate').on('blur', '#BillDate', function () { convert_date(BillDate, 'modal-message'); });
    $(document).off('click', '#btndate').on('click', '#btndate', function () { show_calendar('frm.BillDate'); });
</script>

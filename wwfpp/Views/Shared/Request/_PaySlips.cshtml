@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Overtime Report";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());

}
@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>



<!-- Controls row under the header -->
<div class="p-0 bg-white rounded mb-3">
    <!-- First row: filters -->
    <div class="row align-items-center mt-2">
        <div class="col-auto">
            @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter,
                new { @class = "form-select me-4", style = "width:150px;" })
        </div>
        <div class="col-auto">
            @Html.DropDownList("EmployeeFilter", (SelectList)ViewBag.EmployeeFilter,
                new { @class = "form-select", style = "width:300px;" })
        </div>
    </div>

    <!-- Second row: Start & End Date in same column -->
    <div class="row align-items-center mt-2">
        <div class="col-auto">Single Period:
        </div>
        <div class="col-auto">
            @Html.DropDownList("year", (SelectList)ViewBag.CalYears, "-- Year --", new { @class = "form-select" })
        </div>
        <div class="col-auto">
            @Html.DropDownList("month", (SelectList)ViewBag.CalMonth, "-- Month --", new { @class = "form-select" })
        </div>
        <div class="col-auto">
            <button id="btnSinglePeriod" class="button bg-green">Export</button>
        </div>
    </div>



</div>



@section Scripts {
    <script>

        $("#StatusFilter").off("change").on("change", function () {
            const statusV = $(this).val();
            var ddl = $('#EmployeeFilter');
            ddl.empty();

            // Add placeholder option depending on status
            if (statusV === "A") {
                ddl.append('<option value="">-- Select Active Employee --</option>');
            } else {
                ddl.append('<option value="">-- Select Inactive Employee --</option>');
            }
            // Reset selected value
            ddl.val('');

            // Reload employees via AJAX
            $.getJSON('/Employee/GetEmployeesByStatus', { status: statusV }, function (data) {
                $.each(data, function (i, emp) {
                    ddl.append($('<option>', {
                        value: emp.value,   // ✅ must match property name from JSON
                        text: emp.text
                    }));
                });
            });
            table.draw();
        });

        $(document).off("click", "#btnSinglePeriod").on("click", "#btnSinglePeriod", function() {
            var Year = $("#year").val();
            var Month = $("#month").val();
            var Employee = $("#EmployeeFilter").val();

            // Validation
            if (!Year) {
                $('#message').removeClass().addClass('error').html(msg_select_year).show();
                return false;
            }
            if (!Month) {
                $('#message').removeClass().addClass('error').html(msg_select_month).show();
                return false;
            }
            if (!Employee) {
                $('#message').removeClass().addClass('error').html(msg_select_employee).show();
                return false;
            }

            fetch('/Request/ExportPaySlip', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: `empId=${Employee}&year=${Year}&month=${Month}`
            })
            .then(response => response.json())
            .then(res => {
                if (res.status === "success") {
                    // Just download the file silently
                    const link = document.createElement('a');
                    link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + res.fileContent;
                    link.download = res.fileName;
                    link.click();
                } else if (res.status === "nosalary") {
                    // Only show message if no salary
                    $('#message').removeClass().addClass('error').html("No salary data found for this employee.").show();
                }
            })
            .catch(error => {
                $('#message').removeClass().addClass('error').html("Error in process: " + error).show();
            });
        });





    </script>
}


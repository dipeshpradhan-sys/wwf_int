@model wwfpp.Models.EmployeeFutureLeaveViewModel
@{
    string mode = ViewBag.mode;
    string? DATE_FORMAT = ViewBag.DATE_FORMAT;
}
<script language="javascript">
        $(document).ready(function () {

            $('#leave_from_date').datepicker({
                    format: 'mm/dd/yyyy',
                    autoclose: true,
                    todayHighlight: true,
                    todayBtn: "linked",   // ensures clicking Today sets the date
                    clearBtn: true
                });


            $('#leave_to_date').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true,
                todayBtn: "linked",   // ensures clicking Today sets the date
                clearBtn: true
            });
        });
</script>
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
    @Html.HiddenFor(m => m.id)
    @Html.Hidden("mode", "")
    <input type="hidden" name="working_hrs" id="working_hrs" value="@ViewBag.NormalWorkingHours" />

    <div class="form-group row p-1">

    @if (mode == "add")
    {
        <label class="col-lg-12 col-form-label-lg">Employee<span class="text-danger">*</span></label>
        <div class="col-lg-12">
            @Html.DropDownListFor(m => m.emp_id, (SelectList)ViewBag.EmployeeList, "-- Select --", new { @class = "form-select" })
        </div>
    }
    else
    {
        string empStatus = Model.emp_status ?? "";
        <label class="col-lg-12 col-form-label-lg">Employee:<span class="text-danger">*</span> @ViewBag.Employee [@empStatus] @Html.HiddenFor(m => m.emp_id)</label>
        <div class="col-lg-12">
            &nbsp;
        </div>
    }
    <label class="col-lg-12 col-form-label-lg">Fiscal Year<span class="text-danger">*</span></label>
    <div class="col-lg-12">
        @Html.DropDownListFor(m => m.FutureFiscalYear, (SelectList)ViewBag.FiscalYearFutureList, "-- Select Fiscal Year --", new { @class = "form-control-sm", @id = "FutureFiscalYear" })
    </div>
    <label class="col-lg-12 col-form-label-lg">Leave<span class="text-danger">*</span></label>
    <div class="col-lg-12">
        @Html.DropDownListFor(m => m.LeaveTypeId, (SelectList)ViewBag.LeaveTypeList, "-- Select Leave --", new { @class = "form-control-sm", @id = "LeaveTypeId" })
    </div>

    <label class="col-lg-12 col-form-label-lg">Start Date <span class="text-danger">*</span>&nbsp;(@DATE_FORMAT)</label>
    <div class="col-lg-12">
        @Html.TextBoxFor(m => m.LeaveFromDate, "{0:MM/dd/yyyy}",new { @class = "form-control form-control-sm", @id = "leave_from_date", autocomplete = "off" })
    </div>

    <label class="col-lg-12 col-form-label-lg">End Date<span class="text-danger">*</span>&nbsp;(@DATE_FORMAT)</label>
    <div class="col-lg-4">
         @Html.TextBoxFor(m => m.LeaveToDate, "{0:MM/dd/yyyy}",new { @class = "form-control form-control-sm", @id = "leave_to_date", autocomplete = "off"})
    </div>

    <label class="col-lg-12 col-form-label-lg">Leave in Hours<span class="text-danger">*</span></label>
    <div class="col-lg-4">
        @Html.TextBoxFor(m => m.LeaveInHours, new { @class = "form-control", @id = "leave_in_hrs", type = "number", step = "0.01", ReadOnlyMemory = "readonly" })
    </div>

    <label class="col-lg-12 col-form-label-lg">Leave in Days<span class="text-danger">*</span></label>
    <div class="col-lg-4" id="leaveindays">
        @Model.LeaveInDays
    </div>
    <label class="col-lg-12 col-form-label-lg">Status<span class="text-danger">*</span></label>
    <div class="col-lg-4" id="leavestatus">
        @Model.Status
    </div>
</div>
@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true" && Model.emp_status == "Active")
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}

<script>    
// Toggle between Edit and Update
$(document).off("click", "#btnSave").on("click", "#btnSave", function () {
    var btn = $(this);
    if (btn.text() == "Edit") {$("#ModalID .modal-title").text("Update");btn.text("Update");$("#btnC").text("Cancel");return;}  
    if (btn.text() === "Update" || btn.text() === "Save") 
    {
        if ( $("#mode").val() === "add")
        {
            if (checkInput('cmb', 'emp_id', 'Employee is required.', 'modal-message') == false) { return false; }
        }
        if ( checkInput( 'cmb', 'FutureFiscalYear', 'Fiscal year is required.', 'modal-message') == false ) {return false;}
        if ( checkInput( 'cmb', 'LeaveTypeId', 'Leave is required.', 'modal-message') == false ) {return false;}
        if ( checkInput( 'txt', 'leave_from_date', 'Start Date is required.', 'modal-message') == false ) {return false;}
        if ( checkInput( 'txt', 'leave_to_date', 'End Date is required.', 'modal-message') == false ) {return false;}

        submitSaveUpdate("/Request/LeaveFuture");
    }
});
</script>



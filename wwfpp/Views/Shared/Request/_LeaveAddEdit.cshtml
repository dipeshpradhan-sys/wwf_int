@model wwfpp.Models.EmployeeLeaveViewModel
@{
    string mode = ViewBag.mode;
    string? DATE_FORMAT = ViewBag.DATE_FORMAT;
    string EmployeeNoManager = ViewBag.EmployeeNoManager;
    
    DateTime start_fiscal_date = Convert.ToDateTime(Context.Session.GetString("DateFrom"));
    string s_start_fiscal_date = start_fiscal_date.ToString(DATE_FORMAT);

    DateTime end_fiscal_date = Convert.ToDateTime(Context.Session.GetString("DateTo"));
    string s_end_fiscal_date = end_fiscal_date.ToString(DATE_FORMAT);
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
    @Html.HiddenFor(m => m.id)
    @Html.Hidden("mode", "")
    <input type="hidden" name="working_hrs" id="working_hrs" value="@ViewBag.NormalWorkingHours" />
    @if (mode == "edit" && !string.IsNullOrEmpty(EmployeeNoManager))
    {
        <div class="alert alert-warning mb-3" role="alert">
            <strong>Notice:</strong> @EmployeeNoManager
        </div>
    }

    <div class="form-group row p-1">

    @if (mode == "add")
    {
        <label class="col-lg-12 col-form-label-lg">Employee<span class="text-danger">*</span></label>
        <div class="col-lg-12">
            @Html.DropDownListFor(m => m.emp_id, (SelectList)ViewBag.EmployeeList, "-- Select --", new { @class = "form-select" })
        </div>
    }
    else
    {
        string empStatus = Model.emp_status ?? "";
        <label class="col-lg-12 col-form-label-lg">Employee:<span class="text-danger">*</span> @ViewBag.Employee [@empStatus] @Html.HiddenFor(m => m.emp_id)</label>
        <div class="col-lg-12">
            &nbsp;
        </div>
    }


    <label class="col-lg-12 col-form-label-lg">Leave<span class="text-danger">*</span></label>
    <div class="col-lg-12">
        @Html.DropDownListFor(m => m.leave_type_id, (SelectList)ViewBag.LeaveTypeList, "-- Select Leave --", new { @class = "form-control-sm" })
    </div>


    <label class="col-lg-12 col-form-label-lg">Start Date <span class="text-danger">*</span>&nbsp;(@DATE_FORMAT)</label>
    <div class="row">
        <div class="col-lg-4">
            @Html.TextBoxFor(m => m.leave_from_date, "{0:" + DATE_FORMAT + "}", new { @class = "form-control form-control-sm", @ReadOnly = "readonly" })
        </div>
        <div class="col-lg-8">
            <Input Type="Button" name="btndate" Value="Date..." OnClick="show_calendar('frm.leave_from_date')" class="button bg-sky">
        </div>
    </div>

    <label class="col-lg-12 col-form-label-lg">Start Date <span class="text-danger">*</span>&nbsp;(@DATE_FORMAT)</label>
    <div class="row">
        <div class="col-lg-4">
            @Html.TextBoxFor(m => m.leave_to_date, "{0:" + DATE_FORMAT + "}", new { @class = "form-control form-control-sm", @ReadOnly = "readonly" })
        </div>
        <div class="col-lg-8">
            <Input Type="Button" name="btndate" Value="Date..." OnClick="show_calendar('frm.leave_to_date')" class="button bg-sky">
        </div>
    </div>

    <label class="col-lg-12 col-form-label-lg">Leave in Hours<span class="text-danger">*</span></label>
    <div class="col-lg-4">
        @Html.TextBoxFor(m => m.leave_in_hrs, new { @class = "form-control", type = "number", step = "0.01", @readonly = "readonly" })
    </div>

    <label class="col-lg-12 col-form-label-lg">Leave in Days<span class="text-danger">*</span></label>
    <div class="col-lg-4" id="leaveindays">
        @Model.leave_in_days
    </div>
    <label class="col-lg-12 col-form-label-lg">Description</label>
    <div class="col-lg-4">
        @Html.TextAreaFor(m => m.leave_desc, new { @class = "form-control", style = "height:100px; width:400px;" })
    </div>

    @if (mode == "edit")
    {
        <br /><hr />
        <label class="col-lg-12 col-form-label-lg">Status</label>
        <div class="col-lg-4" id="mainleavestatus">@Model.app_status</div>
        <label class="col-lg-12 col-form-label-lg">Action By</label>
        <div class="col-lg-4">@Model.app_by_name</div>

        <label class="col-lg-12 col-form-label-lg">Date</label>
        <div class="col-lg-4">@(Model.app_date?.ToString(DATE_FORMAT) ?? "N/A")</div>

        <label class="col-lg-12 col-form-label-lg">Remarks</label>
        <div class="col-lg-4">@Model.app_remarks</div>

        if (Model.can_status == "Approved" || Model.can_status == "Pending")
        {
            <hr />
            <label class="col-lg-12 col-form-label-lg">Cancellation</label>
            <hr />
            
            <label class="col-lg-12 col-form-label-lg">Reason for cancellation</label>
            <div class="col-lg-4">@Model.can_desc</div>

            <label class="col-lg-12 col-form-label-lg">Status</label>
            <div class="col-lg-4">@Model.can_status</div>

            <label class="col-lg-12 col-form-label-lg">Action By</label>
            <div class="col-lg-4">@Model.can_by_name</div>

            <label class="col-lg-12 col-form-label-lg">Date</label>
            <div class="col-lg-4">@Model.can_date</div>

            <label class="col-lg-12 col-form-label-lg">Remarks</label>
            <div class="col-lg-4">@Model.can_remarks</div>
    
        }
    }
    <div class="col-lg-12"></div>
    <div id="message_header">
        <p class="notify">
            Note:<br/>
            - Please provide the Leave Start Date and End Date within fiscal year <u>@s_start_fiscal_date</u> and <u>@s_end_fiscal_date</u>.<br />
            - Two types of leave or full day and half day leave can't be fill up in one leave request. <br />
            - For this separate leave request should be submitted.
        </p>
    </div>
</div>
@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true" && Model.emp_status == "Active")
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}
    <script>    
    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") { $("#ModalID .modal-title").text("Update"); btn.text("Update"); $("#btnC").text("Cancel"); return; }
        if (btn.text() === "Update" || btn.text() === "Save") {
            if ( $("#mode").val() === "add")
            {
                if (checkInput('cmb', 'emp_id', 'Employee is required.', 'modal-message') == false) { return false; }
            }
            if ( checkInput( 'cmb', 'leave_type_id', 'Leave is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'leave_from_date', 'Start Date is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'leave_to_date', 'End Date is required.', 'modal-message') == false ) {return false;}

            submitSaveUpdate("/Request/Leave");
        }
    });

    $(document).ready(function() {
        $('#emp_id').change(function() {
            var empId = $(this).val();
            if (empId) {
                $.get('@Url.Action("CheckEmployeeManager", "Request")', { empId: empId })
                    .done(function(response) {
                        if (response.status === "error") {
                            // Show alert div dynamically
                            $('#noManagerAlert').remove(); // remove old if exists
                            $('<div id="noManagerAlert" class="alert alert-warning mb-3" role="alert">' +
                                '<strong>Notice:</strong> ' + response.message +
                                '</div>').insertBefore('.form-group.row.p-1:first');
                        } else {
                            $('#noManagerAlert').remove(); // hide if manager exists
                        }
                    });
            }
        });
    });
    </script>


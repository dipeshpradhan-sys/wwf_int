@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Overtime";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());

}
<style>
    #tblDataList td, #tblDataList th {
        padding: 15px 10px;
        font-size: 15px;
        height: 15px;
    }
</style>
@Html.AntiForgeryToken()
@Html.Hidden("mode", "")
@Html.Hidden("ilaka", "/Request/Overtime")

<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<!-- Global overlay spinner -->
<div id="processingOverlay" style="display:none;
    position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(0,0,0,0.4); z-index:2000;
    flex-direction:column; align-items:center; justify-content:center;">

    <div class="spinner-border text-light mb-2" role="status">
        <span class="visually-hidden">Processing...</span>
    </div>
    <div id="processingText" class="text-light fw-bold">Processing...</div>
</div>
<div class="d-flex align-items-center">
    <label class="me-2">Fiscal Year:</label>
    <select id="FiscalYearList" class="form-control-sm" asp-items="ViewBag.FiscalYearList">
        <option value="">-- Fiscal year --</option>
    </select>

    <label class="me-2">Employee status:</label>
    @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter,new { @class = "form-select me-4", style = "width:150px;" })

    <label class="me-2">Overtime Status:</label>
    @Html.DropDownList("LeaveStatusFilter", (SelectList)ViewBag.StatusPAFilter,
        new { @class = "form-select me-4", style = "width:150px;" })
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>

<!-- DataTable -->
<div class="form-group p-2">
    <table id="tblData" class="display compact nowrap" style="width:100%">
        <thead>
            <tr class="bg-secondary bg-opacity-25">
                <th width="3%"><input type="checkbox" id="selectAll" /></th>
                <th>Employee name</th>
                <th>Date</th>
                <th>Submit Date</th>
                <th>Hours</th>
                <th>Requested By</th>
                <th>Reason/Description</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
    </table>
</div>
@await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

@section Scripts {
    <script>
        var perma = '@ViewBag.apern';
        var perme = '@ViewBag.epern';
        var ilaka = "/Request/Overtime";
        var selectedIds = new Set();
        var table;
        $(document).ready(function ()
        {
            GetAllData(ilaka, "otReqId", [
                { data: "employeeName", name: "EmployeeName", autoWidth: false },
                { data: "otDate", name: "OtDate", autoWidth: false },
                { data: "submitDate", name: "SubmitDate", autoWidth:  false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                { data: "totalHours", name: "TotalHours", autoWidth:  false},
                { data: "requestedBy", name: "RequestedBy", autoWidth:  false},
                { data: "otDesc", name: "OtDesc", autoWidth: false },
                { data: "status", name: "Status", autoWidth: false },
                ],
                {
                    FilterValue1: "FiscalYearList",
                    FilterValue2: "EmployeeStatusFilter",
                    FilterValue3: "LeaveStatusFilter"
                }
                );
            });
            $("#EmployeeStatusFilter, #FiscalYearList, #LeaveStatusFilter").off("change").on("change", function () {
                    table.draw();
            });

            $(document).on("click", "#tblData .button", function () {ViewData($(this).data("id"),$('#FiscalYearList').val());});
            $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});

      

        function calculateOvertime(index) {
            const startHour = parseInt(document.getElementById(`start_hour${index}`).value || 0);
            const startMinute = parseInt(document.getElementById(`start_minute${index}`).value || 0);
            const endHour = parseInt(document.getElementById(`end_hour${index}`).value || 0);
            const endMinute = parseInt(document.getElementById(`end_minute${index}`).value || 0);

            const start = new Date(2000,1,1,startHour,startMinute);
            const end = new Date(2000,1,1,endHour,endMinute);

            let diff = (end - start) / (1000*60*60);
            if (diff < 0) diff = 0;

            const hoursEl = document.getElementById(`ot_hours${index}`);
            if (hoursEl) hoursEl.value = diff.toFixed(2);

            recalcTotalHours();
        }

        function clearOvertimeSession(index) {
            document.getElementById(`start_hour${index}`).selectedIndex = 0;
            document.getElementById(`start_minute${index}`).selectedIndex = 0;
            document.getElementById(`end_hour${index}`).selectedIndex = 0;
            document.getElementById(`end_minute${index}`).selectedIndex = 0;
            document.getElementById(`ot_hours${index}`).value = "0.00";
            recalcTotalHours();
        }

        function generateHours() {
            let html = "";
            for (let h=0; h<24; h++) {
                html += `<option value="${h}">${h.toString().padStart(2,'0')}</option>`;
            }
            return html;
        }

        function generateMinutes() {
            return `<option value="0">00</option>
                    <option value="15">15</option>
                    <option value="30">30</option>
                    <option value="45">45</option>`;
        }

        function addOvertimeRow() {
            // Count only actual session rows (ignore Add button row)
            const rowCount = document.querySelectorAll('#sessionRows .row[id^="sessionRow_"]').length;
            const newIndex = rowCount;

            const template = `
                <div class="row mb-2 align-items-center" id="sessionRow_${newIndex}">
                    <div class="col-2">
                        <select id="start_hour${newIndex}"
                                name="Sessions[${newIndex}].StartHour"
                                class="form-control-sm"
                                onchange="calculateOvertime(${newIndex})">
                            ${generateHours()}
                        </select>
                    </div>
                    <div class="col-2">
                        <select id="start_minute${newIndex}"
                                name="Sessions[${newIndex}].StartMinute"
                                class="form-control-sm"
                                onchange="calculateOvertime(${newIndex})">
                            ${generateMinutes()}
                        </select>
                    </div>
                    <div class="col-2">
                        <select id="end_hour${newIndex}"
                                name="Sessions[${newIndex}].EndHour"
                                class="form-control-sm"
                                onchange="calculateOvertime(${newIndex})">
                            ${generateHours()}
                        </select>
                    </div>
                    <div class="col-2">
                        <select id="end_minute${newIndex}"
                                name="Sessions[${newIndex}].EndMinute"
                                class="form-control-sm"
                                onchange="calculateOvertime(${newIndex})">
                            ${generateMinutes()}
                        </select>
                    </div>
                    <div class="col-4 d-flex">
                        <input type="text" id="ot_hours${newIndex}"
                               name="Sessions[${newIndex}].Hours"
                               class="form-control-sm me-1 w-25"
                               readonly value="0.00" />
                        <button type="button" class="btn btn-sm btn-secondary me-1" onclick="clearOvertimeSession(${newIndex})">Clear</button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeOvertimeRow(${newIndex})">Remove</button>
                    </div>
                </div>`;

            // Insert new row above the Add button row
            const addBtnRow = document.querySelector("#sessionRows > div.mt-2");
            addBtnRow.insertAdjacentHTML("beforebegin", template);

            // Update hidden count
            document.getElementById("hid_overtime_row_count").value = newIndex + 1;
        }



        function removeOvertimeRow(index) {
            const row = document.getElementById(`sessionRow_${index}`);
            if (row) {
                row.remove();
                recalcTotalHours();
            }
        }

        function recalcTotalHours() {
            let total = 0;
            document.querySelectorAll('[id^="ot_hours"]').forEach(el => {
                total += parseFloat(el.value || 0);
            });
            document.getElementById("total_hours").value = total.toFixed(2);
        }
    </script>

}


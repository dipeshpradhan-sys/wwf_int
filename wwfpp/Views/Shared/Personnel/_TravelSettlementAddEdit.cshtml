                <tr class="tr-section">
                    <td>4</td>
                    <td>@Html.TextBoxFor(m => m.TravelSettlement.ChargeFundPer4, new { @class = $"form-control form-control-sm charge-input {per_class}", style = "width:100px;", maxlength = "6", id = "ChargeFundPer4", @per_readonly})</td>
                    <td>@Html.TextBoxFor(m => m.TravelSettlement.ChargeFundAmt4, new { @class = $"form-control form-control-sm charge-input {amt_class}", style = "width:100px;", maxlength = "10", id = "ChargeFundAmt4", @amt_readonly })</td>
                    <td>@Html.DropDownListFor(m => m.TravelSettlement.ChargeFundId4, (SelectList)ViewBag.FundSource, "-- Select Fund Source --", new { @class = "form-select travel-fund-source", style = "width:100%;" } )</td>

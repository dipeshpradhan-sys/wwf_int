                    <td>@Html.TextBoxFor(m => m.TravelSettlement.ChargeFundAmt3, new { @class = $"form-control form-control-sm charge-input {amt_class}", style = "width:100px;", maxlength = "10", id = "ChargeFundAmt3", @amt_readonly })</td>
                    <td>@Html.DropDownListFor(m => m.TravelSettlement.ChargeFundId3, (SelectList)ViewBag.FundSource, "-- Select Fund Source --", new { @class = "form-select travel-fund-source", style = "width:100%;" })</td>

    <div class="form-group row p-2">
        <table class="table-section">
            <tr>
                <td width="25%" class="bold">Remarks</td>
                <td width="75%">@Html.TextAreaFor(m => m.TravelSettlement.Remarks, new { @class = "form-control", rows = 2, maxlength = "255", id="Remarks" })</td>
            </tr>
        </table>
    </div>

    <div class="form-group row p-2">
        @if (!string.IsNullOrWhiteSpace(Model.TravelSettlement.AppStatus))
        {
            string set_app_status = Model.TravelSettlement.AppStatus;
            if (set_app_status == "A")
            {
                set_app_status = "Verified";
            }
            else if (set_app_status == "T")
            {
                set_app_status = "Saved";
            }
            else
            {
                set_app_status = "Pending";
            }
            <table class="table-section">
                <tbody>
                    <tr class="tr-section">
                        <td width="100%" colspan="3">Status</td>
                    </tr>
                    <tr class="bold">
                        <td width="24%">Status</td>
                        <td width="1%"> : </td>
                        <td width="75%">@set_app_status</td>
                    </tr>
                    @if (set_app_status != "Saved")
                    {
                        <tr class="bold">
                            <td width="24%">Action By</td>
                            <td width="1%"> : </td>
                            <td width="75%">@Model.TravelSettlement.AppByName</td>
                        </tr>
                        @if (set_app_status == "Verified")
                        {
                            <tr class="bold">
                                <td width="24%">Date</td>
                                <td width="1%"> : </td>
                                <td width="75%">@string.Format("{0:" + DATE_FORMAT + "}", Model.TravelSettlement.AppDate)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="form-group row p-2">
        <table class="table-section red">
            <tr>
                <td>
                    <p class="bold">Note:</p>
                    <ul>
                        <li>Receipts must be attached sequentially</li>
                        <li>Attach boarding pass in case of Air Travel.</li>
                        <li>All advance & travel expenses must be settled/reimbursed within 15 days of completion of travel or incurring of the expenses.</li>
                        <li>
                            App expenses must be supported with receipts with stating the name & address of
                            the person receiving the money (payee), the name of the Organization paying(payer),
                            Date of payment, description, quantity & amound of the items and the signature/stamp
                            of the payee
                        </li>
                    </ul>
                </td>
            </tr>
        </table>
    </div>



    @if (SettlementType != "A" && Model.Travel.EmpStatus == "A" &&
            cur_fiscal_year == Model.Travel.FiscalYear &&
            cur_emp_id == Model.Travel.EmpId.ToString()
        )
    {
        if (today >= Model.Travel.DateTo) { IsAbleToSubmit = true; }
    }
    @if (IsAbleToSubmit == true && mode == "add" && ViewBag.apern == "true")
    {
        <script>renderModalSaveSubmitButtons("modal-button-list", @SettlementType);</script>
    }
    else if (IsAbleToSubmit == true && mode == "edit" && ViewBag.epern == "true")
    {
        <script>renderModalSaveSubmitButtons("modal-button-list",  @SettlementType);</script>
    }
    else
    {
        <script>renderModalCloseButton("modal-button-list")</script>
    }
    <script>

        document.getElementById("btnTravelDetailShow").addEventListener("click", function() {
            $("#travel-detail").show();
            $("#divTravelDetailShow").hide();
        });
        document.getElementById("btnTravelDetailHide").addEventListener("click", function() {
            $("#travel-detail").hide();
            $("#divTravelDetailShow").show();
        });

        document.getElementById("chkReqAdvSet").addEventListener("click", function() { showHideReqAdvSet(); });
        $(document).ready(function() {
            $(".travel-fund-source").select2({ dropdownParent: $('#ModalID'), placeholder: "Select Fund Source", allowClear: true });
        });
        document.getElementById("ChargePerOrAmt").addEventListener("change", function() { TravelSetPercentAmount(); });
        document.querySelectorAll(".charge-input").forEach(function(el) {
            el.addEventListener("blur", function() {
                OnlyNumeric(el.id, "modal-message");
                TravelSetCalculateNetPercent();
            });
        });
        $(document).off("click", "#btnSave, #btnSubmit").on("click", "#btnSave, #btnSubmit", function() {
            var cnt = 0;
            var msg_to_swtich_and_show = "Are you sure you want to Submit this travel settlement?";
            document.getElementById("chkSaveOnly").value = "0";

            if (this.id === "btnSave") {
                msg_to_swtich_and_show = "Are you sure you want to Save this travel settlement?";
                document.getElementById("chkSaveOnly").value = "1";
            }

            if (document.getElementById('ChkReqAdvSet').checked === false) {
                if (checkInput('txt', 'TravelDate', 'Travel Date is required.', 'modal-message') == false) { return false; }
                if (checkInput('txt', 'ReturnDate', 'Return Date is required.', 'modal-message') == false) { return false; }

                var jj = $("#HidTravSetRowCount").val();
                if (jj === "") { jj = 0; }

                //check for all lines are khaali
                for (i = 1; i <= jj; i++) {
                    if (tType.toUpperCase() == "INTERNATIONAL") {
                        if ($("#BillDate" + i).val().trim() === "" && $("#Location" + i).val().trim() === "" && $("#Description" + i).val().trim() === "" && $("#RefField" + i).val().trim() === "" && $("#IntCurName" + i).val().trim() === "") { cnt++; }
                    }
                    else {
                        if ($("#BillDate" + i).val().trim() === "" && $("#Location" + i).val().trim() === "" && $("#Description" + i).val().trim() === "" && $("#RefField" + i).val().trim() === "") { cnt++; }
                    }
                }
                if (jj === cnt) { showError("At least one detail information is required. ", "modal-message"); return false; }

                if (tType.toUpperCase() === "INTERNATIONAL") {
                    if ($("#TotalCash").val().trim() === "" || $("#TotalCash").val().trim() === "0" || $("#TotalCash").val().trim() === "0.00") {
                        showError("Any amount on detail is required. ", "modal-message");
                        return false;
                    }
                }
                else {
                    if ($("#TotalBill").val().trim() === "" || $("#TotalBill").val().trim() === "0" || $("#TotalBill").val().trim() === "0.00") {
                        showError("Any bill amount on detail is required. ", "modal-message");
                        return false;
                    }
                }

                /*## Moved to below: 2023-Nov-11 */
                if (this.id === "btnSubmit") {
                    //----------------------------------------------------------------------------------------------
                    /* On request it is moved from ## above*/
                    //----------------------------------------------------------------------------------------------
                    for (let i = 1; i <= 4; i++) {
                        let ChargeFundPer = $("#ChargeFundPer" + i).val().trim();
                        if (ChargeFundPer === "") { ChargeFundPer = 0; }
                        ChargeFundPer = parseFloat(ChargeFundPer);
                        if (ChargeFundPer != 0) {
                            if ($("#ChargeFundId" + i).val().trim() === "") {
                                showError("Select fund source for given value.", "modal-message");
                                return false;
                            }
                        }
                    }

                    let TChargeFundPer = $("#TChargeFundPer").val().trim();
                    if (TChargeFundPer === "") { TChargeFundPer = 0; }
                    TChargeFundPer = parseFloat(TChargeFundPer);
                    if (TChargeFundPer != 100) {
                        showError("Charge to percentage is not equal to 100.", "modal-message");
                        return false;
                    }
                }//end of submit
            } //end of ChkReqAdvSet

            submitTravelSettlement("/Personnel/TravelSettlementSave", msg_to_swtich_and_show);
        });
        function submitTravelSettlement(ilaka, parm_msg) {
            if (confirm(parm_msg) == false) { return false; }
            var formData = $("#frm").serialize();
            $("#btnSave").prop("disabled", true);
            $("#btnSubmit").prop("disabled", true);
            $("#btnC").prop("disabled", true);
            $.post(ilaka, formData).done(function(data) {
                if (data.status === "success") {
                    var table = $("#tblData").DataTable();
                    table.ajax.reload(function() {
                        setTimeout(function() { // ? wait for DOM to settle
                            if (data.id) {
                                // Find the row index by matching the data.id
                                var rowIdx = table.rows().eq(0).filter(function(idx) { return String(table.row(idx).data().id) === String(data.id); });

                                if (rowIdx.length) {
                                    var rowNode = table.row(rowIdx[0]).nodes().to$();
                                    rowNode.addClass("highlight-row");
                                    setTimeout(function() { rowNode.removeClass("highlight-row"); }, 2000);
                                } else {
                                    //console.warn("Row not found for id:", data.id);
                                }
                            }
                        }, 100);
                    }, false); // ?? keep current page

                    showSuccess(data.message);
                    var modal = bootstrap.Modal.getInstance(document.getElementById("ModalID"));
                    if (modal) modal.hide();
                    $("#btnSave").prop("disabled", false);
                    $("#btnSubmit").prop("disabled", false);
                    $("#btnC").prop("disabled", false);
                }
                else {
                    showError(data.message, "modal-message");
                    $("#btnSave").prop("disabled", false);
                    $("#btnSubmit").prop("disabled", false);
                    $("#btnC").prop("disabled", false);
                }
            })
                .fail(function(xhr) {
                    showError(xhr.responseText, "modal-message");
                    $("#btnSave").prop("disabled", false);
                    $("#btnSubmit").prop("disabled", false);
                    $("#btnC").prop("disabled", false);
                });
        }
    </script>

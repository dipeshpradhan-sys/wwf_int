@using wwfpp.Services;
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@inject GlobalOptionServices GlobalOptionServices
@inject SettingsServices SettingsServices
@model List<wwfpp.Models.Settings.LeavePaidClearedViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Leave Paid/Cleared";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}

@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/LeavePaidCleared")

<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<input type="hidden" id="mode" name="mode" value="" />
<input type="hidden" id="Id" name="Id" value="" />
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Fiscal Year : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("FiscalYearFilter", (SelectList)ViewBag.FiscalFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="p-0 bg-white rounded mb-3">
        <div class="row align-items-center">
            <div class="col-auto ms-auto">
                @Html.Raw(ViewBag.ViewButtons)
            </div>
        </div>
    </div>
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="8%">Employee</th>
                    <th width="10%">Perod</th>
                    <th width="10%">Start Date</th>
                    <th width="10%">End Date </th>
                    <th width="58%">Remarks</th>
                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })

    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var enableGrouping = true;
            var table;
            $(document).ready(function ()
            {
                GetAllDataSN(ilaka, "id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "submit_counter", name: "submit_counter", autoWidth: false },
                    { data: "date_from", name: "date_from", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "date_upto", name: "date_upto", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "remarks", name: "remarks", autoWidth: false },
                ],
                {
                    FiscalYearFilter : "FiscalYearFilter",
                    EmployeeStatusFilter : "EmployeeStatusFilter",
                },
                'employee'
                );
                //$("#EmployeeStatusFilter").off("change").on("change", function () {var status = $(this).val();if (!status) {return};GetEmployeeListStatusWise("/Employee/EmployeeList", "EmployeeFilter", status);});
                $(document).on("click", "#tblData .button", function () {ViewData($(this).data("id"));});
                $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});

            });
            $('#tblData_filter').hide();
        </script>
    }
}
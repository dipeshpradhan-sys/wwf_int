@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Settings.EmployeeMedicalReimburseVerificationViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Medical/Insurance verification";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/MedicalInsurance")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
<input type="hidden" id="mode" name="mode" value="" />
<input type="hidden" id="Id" name="Id" value="" />

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Fiscal Year: &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("FiscalYearFilter", (SelectList)ViewBag.FiscalYearFilter, "--Show All--", new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("ApprovalStatusFilter", (SelectList)ViewBag.ApprovalStatusFilter, "--Show All--", new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, "--Show All--", new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="8%">Employee</th>
                    <th width="8%">Type</th>
                    <th width="8%">Ref. Number</th>
                    <th width="9%">Payment Date</th>
                    <th width="7%">Self<br />Amount</th>
                    <th width="7%">Spouse<br />Amount</th>
                    <th width="7%">Other <br />Dependent<br />Amount</th>
                    <th width="7%">Total</th>
                    <th width="9%">Submit<br />Date</th>
                    <th width="8%">Status</th>
                    <th width="7%">Year</th>
                    <th width="7%">Month</th>
                    <th width="7%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })

    @section scripts 
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var enableGrouping = true;
            var table;
            $(document).ready(function () 
            {
                GetAllDataSN(ilaka, "id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "reim_type", name: "reim_type", autoWidth: false },
                    { data: "bill_no", name: "bill_no", autoWidth: false },
                    { data: "bill_date", name: "bill_date", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "self_amt", name: "self_amt", autoWidth: false },
                    { data: "spouse_amt", name: "spouse_amt", autoWidth: false },
                    { data: "other_dep_amt", name: "other_dep_amt", autoWidth: false },
                    { data: "total_amount", name: "total_amount", autoWidth: false },
                    { data: "submit_date", name: "submit_date", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "status", name: "status", autoWidth: false },
                    { data: "sal_year", name: "sal_year", autoWidth: false },
                    { data: "sal_month", name: "sal_month", autoWidth: false, render: function (data, type, row) {if (type === 'display' || type === 'filter') {if (data !== null){var monthIndex = parseInt(data, 10) - 1;return moment().month(monthIndex).format("MMMM");}}return data;}},
                ],
                {
                    FiscalYearFilter : "FiscalYearFilter",
                    ApprovalStatusFilter: "ApprovalStatusFilter",
                    EmployeeStatusFilter : "EmployeeStatusFilter"
                }, 
                'employee' 
                );
                $(document).on("click", "#tblData .button", function () {ViewData($(this).data("id"));});
                $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});

            });
            $('#tblData_filter').hide();

        </script>
    }
}
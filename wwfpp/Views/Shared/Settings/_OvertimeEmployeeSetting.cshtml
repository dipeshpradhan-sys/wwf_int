@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Settings.OvertimeEmployeeSettingViewModel>
@{
    string DATE_FORMAT = ViewBag.DATE_FORMAT;

    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Overtime setting for Employee";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);   
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString()); /*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/OvertimeEmployeeSetting")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

<!-- DataTable -->
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="2%"><input type="checkbox" id="selectAll" ></th>
                    <th width="27%">Employee</th>
                    <th width="10%">Gender</th>
                    <th width="10%">Join Date</th>
                    <th width="10">End Date</th>
                    <th width="10%">Get Overtime?</th>
                    <th width="31%">Approval Person</th>
                </tr>
            </thead>
            <tbody>
                <!-- contents -->
            </tbody>
        </table>
    </div>
    <div id="message_header">@Html.Raw(ShowMsg)</div>
    @if (ViewBag.epern == "true")
    {
        <div class="form-group row p-1">
            <label class="col-sm-4 col-form-label">&nbsp;</label>
            <div class="col-sm-8">
                <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
                <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
            </div>
        </div>
    }
    <div id="AppByTemplate" style="display:none;">@Html.DropDownList("approval_personT", (SelectList)ViewBag.EmployeeList, "--Select--", new { @class = "form-select", style = "width:330px;" })</div>
    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var hideviewaction = "yes";
            var table;
            $(document).ready(function ()
            {   
                GetAllData(ilaka, "emp_id", [
                    { data: "employee", name: "employee", autoWidth: false,render: function (data, type, row) {return '<span style="white-space:normal;">' + data + '</span>';}},
                    { data: "gender", name: "gender", autoWidth: false, render: function (data, type, row) { if (data === "M"){ return "Male";} else { return "Female";}}},
                    { data: "join_date", name: "join_date", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "end_date", name: "end_date", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "is_get_overtime", name: "is_get_overtime", autoWidth: false,render: function(data, type, row, meta) {if (data === "Y") {var Ddata = "checked";} else {var Ddata = "";}return '<input type="checkbox" name="is_get_overtime"' + meta.row +'" id="is_get_overtime"' + meta.row +'" value ="Y" '+ Ddata +' >';}},
                    { data: "approval_person", name: "approval_person", autoWidth: false,render: function (data, type, row, meta){var ctrlName = "approval_person" + meta.row;var $select = $("#AppByTemplate select").clone();$select.attr("id", ctrlName).attr("name", ctrlName);var val = data != null ? data.toString().trim() : "";$select.find("option:selected").prop("selected", false);$select.find("option").each(function () {if ($(this).val() === val) {$(this).attr("selected", "selected");}});return $select.prop("outerHTML");}}
                ],
                {
                    FilterValue: "StatusFilter"
                });
                // Wait for first draw to complete before changing page length                
                $(document).one('init.dt', '#tblData', function () {table.page.len(-1).draw();})
                $('#tblData_filter').hide();
                $('#tblData_length').hide();

            });
            function collectExtraFields() {
                var extraSettings = [];
                $("#tblData tbody tr").each(function () {
                    var row = $(this);
                    var id = row.find("input.row-checkbox:checked").val();
                    if (selectedIds.has(id)) {
                        extraSettings.push({
                            emp_id: parseInt(id, 10), 
                            employee: "", 
                            emp_status :"", 
                            gender :"", 
                            join_date : null, 
                            end_date : null,
                            is_get_overtime: row.find("input[name^='is_get_overtime']").is(":checked") ? "Y" : "N",
                            approval_person: parseInt(row.find("select[name^='approval_person']").val())
                        });
                    }
                });
                return extraSettings;
            }
            $(document).off("click", "#btnSave").on("click", "#btnSave", function () {$("#mode").val("update");updateDataJSON(ilaka+"Save");});
            $("#StatusFilter").off("change").on("change", function () {const statusV = $(this).val();
                if (!statusV) {return;}
                const $myButton =  $("#btnSave");
                if ($myButton.length)
                { 
                    if (statusV === "A")
                    {
                        $myButton.show() 
                        $('#tblData_length').hide();
                        table.page.len(-1).draw();
                    } else {
                        $myButton.hide();
                        $('#tblData_length').show();
                        table.page.len(10).draw();
                    }
                }
                table.draw();
            });
        </script>
    }
}

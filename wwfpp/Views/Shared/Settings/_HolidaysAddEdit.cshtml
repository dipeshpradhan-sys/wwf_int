@using wwfpp.Services 
@inject SettingsServices SettingsServices
@model wwfpp.Models.Settings.HolidaysViewModel
@{
    string mode = ViewBag.mode;
    string DATE_FORMAT = ViewBag.DATE_FORMAT;
    string holiday_date = Model.holiday_date.ToString();
    string s_holiday_date = SettingsServices.DateformatToDt(holiday_date);
}
<!-- (A) HTML DIALOG BOX -->
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
@Html.HiddenFor(m => m.id) <!-- Needed for Edit -->
@Html.HiddenFor(m => m.fiscal_year)
@Html.Hidden("h_holiday_date", s_holiday_date)

    <div class="form-group row p-1">

        <label class="col-lg-12 col-form-label-lg">Fiscal Year<span class="text-danger">*</span> @Model.fiscal_year_abb</label>
    
        <label class="col-lg-12 col-form-label-lg">Date<span class="text-danger">*</span>&nbsp;(@DATE_FORMAT)</label>
        <div class="row">
            <div class="col-lg-4">
                @Html.TextBox("holiday_date", s_holiday_date, new { @class = "form-control", maxlength = "10" })
            </div>
        <div class="col-lg-8"><Button type="Button" name="btndate" id="btndate" class="button bg-sky">Date...</Button></div>
        </div>
        
        <label class="col-lg-12 col-form-label-lg">Holiday Name<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.TextBoxFor(m => m.remarks, new { @class = "form-control", maxlength = "250" })
        </div>

    </div>

@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true")
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}
    <script>
    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") {$("#ModalID .modal-title").text("Update");btn.text("Update");$("#btnC").text("Cancel");return;}  
        if (btn.text() === "Update" || btn.text() === "Save") {

            if ( checkInput( 'txt', 'holiday_date', 'Code is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'remarks', 'Holiday Name is required.', 'modal-message') == false ) {return false;}

            submitSaveUpdate('@Url.Content("~/Settings/Holidays")');
        }
    });
    $(document).off('blur', '#holiday_date').on('blur', '#holiday_date', function () {convert_date(holiday_date,'modal-message');});
    $(document).off('click', '#btndate').on('click', '#btndate', function () {show_calendar('frm.holiday_date');});
    </script>
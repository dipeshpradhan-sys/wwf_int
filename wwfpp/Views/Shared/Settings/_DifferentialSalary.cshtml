@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Settings.DifferentialSalaryViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Differential salary";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "Delete: It will delete all the records of the selected fiscal year";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/DifferentialSalary")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Fiscal Year : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("FiscalYearFilter", (SelectList)ViewBag.FiscalFilter, "-- Select --", new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="27%">Employee</th>
                    <th width="8%">Year</th>
                    <th width="8%">Month</th>
                    <th width="8%">Basic Salary</th>
                    <th width="8%">PF +</th>
                    <th width="8%">Gratuity +</th>
                    <th width="8%">SSF +</th>
                    <th width="8%">PF -</th>
                    <th width="8%">Gratuity -</th>
                    <th width="8%">SSF -</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })
    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var hideviewaction = "yes";
            $(document).ready(function ()
            {
                var table;
                GetAllDataSN(ilaka, "id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "emp_year", name: "emp_year", autoWidth: false },
                    { data: "emp_month", name: "emp_month", autoWidth: false, render: function (data, type, row) {if (type === 'display' || type === 'filter') {if (data !== null){var monthIndex = parseInt(data, 10) - 1;return moment().month(monthIndex).format("MMMM");}}return data;}},
                    { data: "basic_salary", name: "basic_salary", autoWidth: false },
                    { data: "pf_a", name: "pf_a", autoWidth: false },
                    { data: "gratuity_a", name: "gratuity_a", autoWidth: false },
                    { data: "ssf_a", name: "ssf_a", autoWidth: false },
                    { data: "pf_d", name: "pf_d", autoWidth: false },
                    { data: "gratuity_d", name: "gratuity_d", autoWidth: false },
                    { data: "ssf_d", name: "ssf_d", autoWidth: false }
                ],
                {
                    FilterValue : "FiscalYearFilter",
                });

                $(document).off('click', '#btnImport').on('click', '#btnImport', function ()
                {
	                $("#ModalBody").html("");
	                document.getElementById("mode").value = "add";
	                $.get(ilaka + "AddEdit", { id: 0, mode: "import" }, function (data)
	                {
		                $("#ModalBody").html(data);
		                $("#ModalID .modal-title").text("Import");
		                var modal = new bootstrap.Modal(document.getElementById("ModalID"));
		                modal.show();
	                }).fail(function (xhr) { showError("Error occured while loading record(s): " + xhr.responseText); });
                });

                $(document).off('click', '#btnDownLoadFormat').on('click', '#btnDownLoadFormat', function () {
                    if (confirm(msg_are_you_sure_to_perform_this_action)) {postdata(ilaka+'Export');}
                });

                $(document).off("click", "#btnDeleteSD").on("click", "#btnDeleteSD", function () 
                {
                    if ($("#FiscalYearFilter").val() === ""){showError("Select any fiscal year."); return false;}
                    
                    if (confirm(msg_are_you_sure_to_perform_this_action)) 
                    {
                        $("#mode").val("delete");
                        $.ajax({type: "POST", 
                        url: ilaka+"Delete", 
                        data: JSON.stringify({ selectedIds: [...selectedIds] }),
                        contentType: "application/json; charset=utf-8", 
                        dataType: "json", 
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()},
                        success: function (data) 
                        { 
                            if (data.status) {   /* match your controller return { status = true/false }*/
                                showSuccess(data.message); 
                                $('#tblData').DataTable().ajax.reload(null, false); 
                            } else { 
                                showError("Error: " + data.message); 
                            } 
                        }, 
                        error: function (xhr, status, error) { showError("Request failed: " + error); } }); }
                });


                $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});
            });
        </script>
    }
}
@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Settings.SalaryTaxPercentViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Salary tax percent";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/SalaryTaxPercent")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")
@Html.Hidden("hStatus", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

<!-- DataTable -->
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th colspan="7">Employee Information</th>
                    <th>Percent to be added </th>
                </tr>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll"></th>
                    <th width="29%">Employee Name</th>
                    <th width="20%">Marital Status</th>
                    <th width="10%">Gender</th>
                    <th width="10%">Join Date</th>
                    <th width="10%">End Date</th>
                    <th width="10%">Salary</th>
                    <th width="10%">For dashian amount</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data dynamically injected here -->
            </tbody>
        </table>
    </div>
    <div id="message_header">@Html.Raw(ShowMsg)</div>
    @if (ViewBag.apern == "true" || ViewBag.epern == "true")
    {
        <div class="form-group row p-1">
            <label class="col-sm-4 col-form-label">&nbsp;</label>
            <div class="col-sm-8">
                <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
                <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
            </div>
        </div>
    }
    <div id="tPTemplate" style="display:none;">@Html.DropDownList("percent_for_tax_add", (SelectList)ViewBag.PercentForTaxAdd, "--Select--", new { @class = "form-control", style = "width:100px;" })</div>
    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var hideviewaction = "yes";
            var table;
            $(document).ready(function ()
            {
                GetAllData(ilaka, "empId", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "marital", name: "marital", autoWidth: false },
                    { data: "gender", name: "gender", autoWidth: false },
                    { data: "startDate", name: "startDate", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "endDate", name: "endDate", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "salary", name: "salary", autoWidth: false },
                    { data: "percent_for_tax_add", name: "percent_for_tax_add", autoWidth: false, render: function (data, type, row, meta){var ctrlName = "percent_for_tax_add" + meta.row;var $select = $("#tPTemplate select").clone();$select.attr("id", ctrlName).attr("name", ctrlName);var val = data != null ? data.toString().trim() : "";$select.find("option:selected").prop("selected", false);$select.find("option").each(function () {if ($(this).val() === val) {$(this).attr("selected", "selected");}});return $select.prop("outerHTML");}}
                ],
                {
                    FilterValue: "StatusFilter"
                });
                $('#tblData_filter').hide();
                $('#tblData_length').hide();
                table.page.len(-1).draw();
            });
            function collectExtraFields() {
                var extraSettings = [];
                $("#tblData tbody tr").each(function () {
                    var row = $(this);
                    var id = row.find("input.row-checkbox:checked").val();
                    if (selectedIds.has(id)) {
                        extraSettings.push({
                            empId: parseInt(id, 10), employee: "", marital :"", gender:"", startDate: null, endDate: null, salary: 0,
                            percent_for_tax_add: row.find("select[name^='percent_for_tax_add']").val()
                        });
                    }
                });
                return extraSettings;
            }
            $(document).off("click", "#btnSave").on("click", "#btnSave", function () {$("#mode").val("update");updateDataJSON(ilaka+"Save");});
            $("#StatusFilter").off("change").on("change", function () {const statusV = $(this).val(); if (!statusV) {return;} const $myButton =  $("#btnSave");if(statusV === "A"){$myButton.show();$('#tblData_length').hide();table.page.len(-1).draw();} else {$myButton.hide();$('#tblData_length').show();table.page.len(10).draw();} table.draw();});
        </script>
    }
}

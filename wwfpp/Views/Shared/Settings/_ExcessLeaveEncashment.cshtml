@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Settings.LeaveExcessEncashViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Excess Leave Encashment";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Settings/ExcessLeaveEncashment")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
<input type="hidden" id="mode" name="mode" value="" />
<input type="hidden" id="Id" name="Id" value="" />

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Fiscal Year : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("FiscalFilter", (SelectList)ViewBag.FiscalFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmpStatusFilter", (SelectList)ViewBag.EmpStatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Leave Encash Status : &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th>&nbsp;</th>
                    <th colspan="2">Employee</th>
                    <th colspan="3">Laps [Days]</th>
                    <th colspan="3">Payable [Days]</th>
                    <th>&nbsp;</th>
                    <th colspan="3">Payable [Amount]</th>
                    <th colspan="2">Paid Period</th>
                </tr>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll"></th>
                    <th width="19%">Name</th>
                    <th width="8%">Gender</th>
                    <th width="6%">Annual<br />Leave</th>
                    <th width="6%">Sick<br /> Leave</th>
                    <th width="6%">Total</th>
                    <th width="6%">Annual<br/>Leave</th>
                    <th width="6%">Sick<br />Leave</th>
                    <th width="6%">Total</th>
                    <th width="6%">Salary </th>
                    <th width="6%">Annual<br />Leave</th>
                    <th width="6%">Sick<br />Leave</th>
                    <th width="6%">Total</th>
                    <th width="6%">Month</th>
                    <th width="6%">Year</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <div id="message_header">@Html.Raw(ShowMsg)</div>
    @if (ViewBag.epern == "true")
    {
        <div class="form-group row p-1" id="divMonthYear">
            <div class="row">
                <div class="col-lg-2">Pay Period</div>
                <div class="col-lg-1">Month</div>
                <div class="col-sm-2">
                    @Html.DropDownList("paid_monthT", (SelectList)ViewBag.PaidMonth, "--Select--", new { @class = "form-control", style = "width:90px;" })
                </div>
                <div class="col-lg-1">Year</div>
                <div class="col-sm-6">
                       @Html.DropDownList("paid_yearT", (SelectList)ViewBag.PaidYear, "--Select--", new { @class = "form-control", style = "width:90px;" })
                </div>
            </div>
        </div>
        <div class="form-group row p-1">
            <label class="col-sm-4 col-form-label">&nbsp;</label>
            <div class="col-sm-8">
                <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
                <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
            </div>
        </div>
    }   
    @section scripts 
    {
        <script>
            var currentFY = "@HttpContextAccessor.HttpContext?.Session.GetString("fiscal_year")";
            var perm = "@ViewBag.epern";
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var hideviewaction = "yes";
            var isFixedHeader = true;
            var table;
            $(document).ready(function () 
            {
                GetAllData(ilaka, "indv_leave_id", [
                    { data: "employee", name: "employee", autoWidth: false, render: function (data, type, row) {return '<span style="white-space:normal;">' + data + '</span>';}},
                    { data: "gender", name: "gender", autoWidth: false},
                    { data: "cur_annual_leave_laps", name: "cur_annual_leave_laps", autoWidth: false},
                    { data: "cur_sick_leave_laps", name: "cur_sick_leave_laps", autoWidth: false},
                    { data: "cur_leave_laps", name: "cur_leave_laps", autoWidth: false},
                    { data: "tot_annual_leave_paid", name: "tot_annual_leave_paid", autoWidth: false},
                    { data: "tot_sick_leave_paid", name: "tot_sick_leave_paid", autoWidth: false},
                    { data: "tot_leave_paid", name: "tot_leave_paid", autoWidth: false},
                    { data: "bacic_salary", name: "bacic_salary", autoWidth: false},
                    { data: "tot_annual_leave_amt", name: "tot_annual_leave_amt", autoWidth: false},
                    { data: "tot_sick_leave_amt", name: "tot_sick_leave_amt", autoWidth: false},
                    { data: "tot_leave_amt", name: "tot_leave_amt", autoWidth: false},
                    { data: "paid_month", name: "paid_month", autoWidth: false, render: function (data, type, row) { if (data != null && (type === 'display' || type === 'filter')) {return moment().month(data - 1).format("MMMM");}return "";}},
                    { data: "paid_year", name: "paid_year", autoWidth: false}
                ],
                {
                    FilterValue1: "EmpStatusFilter",
                    FilterValue2: "FiscalFilter",
                    FilterValue3: "StatusFilter"
                });
                $(document).one('init.dt', '#tblData', function () {table.page.len(-1).draw();})
                $('#tblData_filter').hide();
                $('#tblData_length').hide();
            });
            function collectExtraFields() {
                var extraSettings = [];

                $("#tblData tbody tr").each(function () {
                    var row = $(this);
                    var id = row.find("input.row-checkbox:checked").val();
                    if (selectedIds.has(id)) {
                        extraSettings.push({
                            indv_leave_id: parseInt(id, 10),
                            emp_id: 0,
                            paid_month: $("#paid_monthT").val() || "0",
                            paid_year:  $("#paid_yearT").val() || "0"
                        });
                    }
                });
                return extraSettings;
            } 

            $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
                if ( checkInput( 'cmb', 'paid_monthT', 'Pay Period Month is required.','message') == false ) {return false;}
                if ( checkInput( 'cmb', 'paid_yearT', 'Pay Period Year is required.','message') == false ) {return false;}
                
                $("#mode").val("update");updateDataJSON(ilaka+"Save");
            
            });
            
            $("#EmpStatusFilter").off("change").on("change", function () {ShowHideSave();});
            $("#FiscalFilter").off("change").on("change", function () {ShowHideSave();});
            $("#StatusFilter").off("change").on("change", function () {ShowHideSave();});
            function ShowHideSave()
            {
                const statusE = $("#EmpStatusFilter").val();
                if (!statusE) {return;}
                const statusV = $("#StatusFilter").val();
                if (!statusV) {return;}
                const fiscalV = $("#FiscalFilter").val();
                if (!fiscalV) {return;}
                const $myButton =  $("#btnSave");
                if ($myButton.length)
                {
                    if (statusE === "A" && fiscalV === currentFY && perm === "true" && statusV === "Pending" )
                    {
                        $("#divMonthYear").show();
                        $myButton.show();
                        $('#tblData_length').hide();
                        table.page.len(-1).draw();
                    } else {
                        $("#divMonthYear").hide();
                        $myButton.hide();
                        $('#tblData_length').show();
                        table.page.len(10).draw(); 
                    }
                }
                table.draw();
            }
        </script>
    }
}

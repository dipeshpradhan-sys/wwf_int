@using wwfpp.Services
@inject SettingsServices SettingsServices
@model wwfpp.Models.Employee.EmployeeEducationViewModel
@{
    string? mode = ViewBag.mode;
}
<!-- (A) HTML DIALOG BOX -->
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
@Html.HiddenFor(m => m.emp_edu_id)

<div class="form-group row p-1">
    @if (mode == "add")
    {
        <label class="col-lg-12 col-form-label-lg">Employee<span class="text-danger">*</span></label>
        <div class="col-lg-12">
            @Html.DropDownListFor(m => m.emp_id, (SelectList)ViewBag.EmployeeList, "-- Select --", new { @class = "form-select" })
        </div>
    }
    else
    {
        string empStatus = Model.emp_status == "A" ? "Active" : "Inactive";
        <label class="col-lg-12 col-form-label-lg">Employee:<span class="text-danger">*</span> @ViewBag.Employee [@empStatus] @Html.HiddenFor(m => m.emp_id)</label>
        <div class="col-lg-12">
            &nbsp;
        </div>
    }

    <div class="row mb-2">
        <div class="col-sm-3 font-weight-bold"></div>
        <div class="col-sm-3"><b>SLC</b></div>
        <div class="col-sm-3"><b>Bachelor Degree</b></div>
        <div class="col-sm-3"><b>Highest Qualification</b></div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-3"><b>Board:</b></div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.slc_board, new { @class = "form-control", maxlength = "200" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.bch_board, new { @class = "form-control", maxlength = "200" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.hgt_board, new { @class = "form-control", maxlength = "200" })</div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-3"><b>Passed Year:</b></div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.slc_passed_year, new { @class = "form-control", maxlength = "8" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.bch_passed_year, new { @class = "form-control", maxlength = "8" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.hgt_passed_year, new { @class = "form-control", maxlength = "8" })</div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-3"><b>Division:</b></div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.slc_division, new { @class = "form-control", maxlength = "40" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.bch_division, new { @class = "form-control", maxlength = "40" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.hgt_division, new { @class = "form-control", maxlength = "40" })</div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-3"><b>Subject (Major):</b></div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.slc_major, new { @class = "form-control", maxlength = "100" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.bch_major, new { @class = "form-control", maxlength = "100" })</div>
        <div class="col-sm-3">@Html.TextBoxFor(m => m.hgt_major, new { @class = "form-control", maxlength = "100" })</div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-3"><b>Remarks:</b></div>
        <div class="col-sm-6">
            @Html.TextAreaFor(m => m.remarks, new { @class = "form-control", rows = "4", cols = "50", maxlength = "500" })
        </div>
    </div>
</div>
@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true" && Model.emp_status == "A")
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}
<script>
    $(document).off("click", "#btnSave").on("click", "#btnSave", function() {
        var btn = $(this);
        if (btn.text() == "Edit") { $("#ModalID .modal-title").text("Update"); btn.text("Update"); $("#btnC").text("Cancel"); return; }
        if (btn.text() === "Update" || btn.text() === "Save") {
            if ($("#mode").val() === "add") {
                if (checkInput('cmb', 'emp_id', 'Employee is required.', 'modal-message') == false) { return false; }
            }
            submitSaveUpdate("/Employee/Education");
        }
    });
</script>
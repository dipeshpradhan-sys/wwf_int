@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Employee.EmployeeFundSourceViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Fund Source";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Employee/EmployeeFundSource")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, "-- Both --", new { @class = "form-select", style = "width:150px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Fiscal Year: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("FiscalYearFilter", (SelectList)ViewBag.FiscalYearFilter, "-- Select --", new { @class = "form-select", style = "width:150px;" })
    </div>
</div>

<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll" /></th>
                    <th width="29%">Employee</th>
                    <th width="20%">Fund Source</th>
                    <th width="10%">Expiry Date</th>
                    <th width="10%">Annual Hours</th>
                    <th width="10%">Start Date</th>
                    <th width="10%">End Date</th>
                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody>

            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var table;
            $(document).ready(function() {
                var table;
                GetAllData(ilaka, "emp_fund_id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "fund_source", name: "fund_source", autoWidth: false },
                    { data: "expiry_date", name: "expiry_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                    { data: "annual_hrs", name: "annual_hrs", autoWidth: false },
                    { data: "start_date", name: "start_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                    { data: "end_date", name: "end_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                ],
                    {
                        FilterValue1: "EmployeeStatusFilter",
                        FilterValue2: "FiscalYearFilter",
                    }
                );
            });
            $(document).on("click", "#tblData .button", function() { ViewData($(this).data("id")) });
            $(document).off('click', '#btnC').on('click', '#btnC', function() { modalCloseCancel($(this)); });
            $(document).off('click', '#btnDownLoadFormat').on('click', '#btnDownLoadFormat', function() { postdata(ilaka + 'DownloadFormat'); });
            $(document).off('click', '#btnImport').on('click', '#btnImport', function () { ImportFile(); });
            function collectExtraFields() {
                return {
                    EmpId: $("#emp_id").val(),
                    eFiscalYear: $("#FiscalYearFilter").val()
                };
            }
            $(function() {
                $("#btnExport").on("click", function() {
                    $("#modal-message").text("").hide();
                    $("#ModalBody").html("");
                    $.get(ilaka + "Export", function (data) {
                        $("#ModalBody").html(data);
                        $("#ModalID .modal-title").text("Export");
                        var modal = new bootstrap.Modal(document.getElementById("ModalID"));
                        modal.show();
                    }).fail(function (xhr) { showError("Error occured while loading record(s): " + xhr.responseText); });

                });
            });
        </script>
    }
}
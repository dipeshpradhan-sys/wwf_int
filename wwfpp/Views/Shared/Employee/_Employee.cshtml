@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Employee.EmployeeViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Employee/Employee")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, "-- Both --", new { @class = "form-select", style = "width:150px;" })
    </div>
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll"></th>
                    <th width="4%">&nbsp;</th>
                    <th width="20%">Employee Name</th>
                    <th width="5%">ID</th>
                    <th width="15%">Email</th>
                    <th width="20%">Immediate Supervisor</th>
                    <th width="20%">Line Director</th>
                    <th width="5%">Status</th>
                    <th width="5%">History</th>
                    <th width="5%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var table;
            $(document).ready(function () {
                GetAllData(ilaka, "emp_id", [
                    { data: "photo", name: "photo", autoWidth: false, render: function(data, type, row, meta) { if (row.photo) { return '<img src="/uploads/documents/photo/' + row.photo + '" width="30" height="40" border="0">'; } else { return '<img src="/uploads/documents/photo/nopicture.jpg" width="30" height="40" border="0">'; } } },
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "emp_code", name: "emp_code", autoWidth: false },
                    { data: "e_mail", name: "e_mail", autoWidth: false },
                    { data: "employee_immediate", name: "employee_immediate", autoWidth: false },
                    { data: "employee_line", name: "employee_line", autoWidth: false },
                    { data: "emp_status", name: "emp_status", autoWidth: false, render: function(data, type, row) { if (data === "A") { return "Active"; } else { return "Inactive"; } } },
                    { data: "history", name: "history", autoWidth: false, 
                        render: function(data, type, row, meta) {
                            return '<a href="#" class="view-history" data-id="' + row.emp_id + '">View</a>';
                        }
                    }

                ],
                    {
                        FilterValue1: "EmployeeStatusFilter"
                    }
                );
            });
            $("#StatusFilter").off("change").on("change", function () {
                const statusV = $(this).val();
                if (!statusV) { return; }
                const $myButton = $("#btnActDact");
                if (statusV === "A") { $myButton.text("Deactivate").removeClass("bg-blue").addClass("bg-org"); } else { $myButton.text("Activate").removeClass("bg-org").addClass("bg-blue"); }
                table.draw();
            });
            $(document).off("click", "#btnExport").on("click", "#btnExport", function () { postdata(ilaka + 'Export'); });
            $(document).on("click", "#tblData .button", function () { ViewData($(this).data("id")); });
            $("#btnUpload").on("click", function () { PopUp(ilaka + 'Upload', document.getElementById("btnUpload").textContent); });
            $(document).off('click', '#btnC').on('click', '#btnC', function () { modalCloseCancel($(this)); });
            
            document.addEventListener('DOMContentLoaded', function() {
                $('#tblData').on('click', 'a.view-history', function(e) {
                    e.preventDefault(); 
                    ViewHistory($(this).data('id')); 
                });
            });

            function ViewHistory(id) {
                $("#ModalBody").html("");
                document.getElementById("mode").value = "history";
                $.get(ilaka + "History", { id: id, mode: "h" }, function(data) {
                    $("#ModalBody").html(data);
                    $("#ModalID .modal-title").text("View");
                    var modal = new bootstrap.Modal(document.getElementById("ModalID"));
                    modal.show();
                }).fail(function(xhr) {
                    showError("Error occured while loading record(s): " + xhr.responseText);
                });
            }
        </script>
    }
}
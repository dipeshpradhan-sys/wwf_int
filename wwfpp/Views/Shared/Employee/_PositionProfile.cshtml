@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Employee.EmployeePositionProfileViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Position Profile";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Employee/PositionProfile")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "") 
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

<!-- DataTable -->
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="2%"><input type="checkbox" id="selectAll"></th>
                    <th width="18%">Employee</th>
                    <th width="16%">Employee Type</th>
                    <th width="16%">Job Family</th>
                    <th width="16%">Career Level</th>
                    <th width="16%">Department</th>
                    <th width="16%">Designation</th>
                </tr>
            </thead>
            <tbody>
         
            </tbody>
        </table>
    </div>
    <div id="message_header">@Html.Raw(ShowMsg)</div>
    @if (ViewBag.epern == "true")
    {
        <div class="form-group row p-1">
            <label class="col-sm-4 col-form-label">&nbsp;</label>
            <div class="col-sm-8">
                <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
                <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
            </div>
        </div>
    }
    <div id="etTemplate" style="display:none;">@Html.DropDownList("employee_type", (SelectList)ViewBag.EmployeeType, new { @class = "form-select me-3", style = "width:120px;" })</div>
    <div id="jfTemplate" style="display:none;">@Html.DropDownList("job_family", (SelectList)ViewBag.JobFamily, "-- Select Job Family --", new { @class = "form-select", style = "width:280px;" })</div>
    <div id="clTemplate" style="display:none;">@Html.DropDownList("emp_level", (SelectList)ViewBag.CareerLevel, "-- Select Career Level --", new { @class = "form-select", style = "width:300px;" })</div>
    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var hideviewaction = "yes";
            var table;
            $(document).ready(function ()
            {
                GetAllData(ilaka, "emp_id", [
                    { data: "employee", name: "employee", autoWidth: false, render: function (data, type, row) {return '<span style="white-space:normal;">' + data + '</span>';}},
                    { data: "employee_type", name: "employee_type", autoWidth: false, render: function(data, type, row, meta) { var ctrlName = "employee_type" + meta.row; var $select = $("#etTemplate select").clone(); $select.attr("id", ctrlName).attr("name", ctrlName); var val = data != null ? data.toString().trim() : ""; $select.find("option:selected").prop("selected", false); $select.find("option").each(function() { if ($(this).val() === val) { $(this).attr("selected", "selected"); } }); return $select.prop("outerHTML"); } },
                    { data: "job_family", name: "job_family", autoWidth: false, render: function(data, type, row, meta) { var ctrlName = "job_family" + meta.row; var $select = $("#jfTemplate select").clone(); $select.attr("id", ctrlName).attr("name", ctrlName); var val = data != null ? data.toString().trim() : ""; $select.find("option:selected").prop("selected", false); $select.find("option").each(function() { if ($(this).val() === val) { $(this).attr("selected", "selected"); } }); return $select.prop("outerHTML"); } },
                    { data: "emp_level", name: "emp_level", autoWidth: false, render: function(data, type, row, meta) { var ctrlName = "emp_level" + meta.row; var $select = $("#clTemplate select").clone(); $select.attr("id", ctrlName).attr("name", ctrlName); var val = data != null ? data.toString().trim() : ""; $select.find("option:selected").prop("selected", false); $select.find("option").each(function() { if ($(this).val() === val) { $(this).attr("selected", "selected"); } }); return $select.prop("outerHTML"); } },
                    { data: "department", name: "department", autoWidth: false, render: function(data, type, row, meta) { return '<input type="text" name="department"' + meta.row + '" id="department"' + meta.row + '" value="' + data + '" class="form-control department-input" style = "width:175px;", maxlength = "50">'; } },
                    { data: "post", name: "post", autoWidth: false, render: function(data, type, row, meta) { return '<input type="text" name="post"' + meta.row + '" id="post"' + meta.row + '" value="' + data + '" class="form-control post-input" style = "width:125px;", maxlength = "50">'; } }
                ],
                {
                    FilterValue: "EmployeeStatusFilter"
                });
                $(document).one('init.dt', '#tblData', function () {table.page.len(-1).draw();})/** Wait for first draw to complete before changing page length*/
                $('#tblData_filter').hide();
                $('#tblData_length').hide();
            });
            function collectExtraFields() {
                var extraSettings = [];
                $("#tblData tbody tr").each(function () {
                    var row = $(this);
                    var id = row.find("input.row-checkbox:checked").val();
                    if (selectedIds.has(id)) {
                        extraSettings.push({
                            emp_id: parseInt(id, 10),employee: "",emp_status :"",
                            employee_type: row.find("select[name^='employee_type']").val(),
                            job_family: row.find("select[name^='job_family']").val(),
                            emp_level: row.find("select[name^='emp_level']").val(),
                            department: row.find("input[name^='department']").val(),
                            post: row.find("input[name^='post']").val()
                        });
                    }
                });
                return extraSettings;
            }
            $(document).off("click", "#btnSave").on("click", "#btnSave", function () {$("#mode").val("update");updateDataJSON(ilaka+"Save");});
            $("#EmployeeStatusFilter").off("change").on("change", function () {const statusV = $(this).val();if (!statusV) {return;}const $myButton =  $("#btnSave");if ($myButton.length){if (statusV === "A" ){$myButton.show();$('#tblData_length').hide();table.page.len(-1).draw();} else {$myButton.hide();$('#tblData_length').show();table.page.len(10).draw();}}table.draw();});
        </script>
    }
}

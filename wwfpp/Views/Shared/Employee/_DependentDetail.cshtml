@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Employee.EmployeeDependentChildrenDetailsViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Dependent Detail";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Employee/DependentDetail")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, "-- Both --", new { @class = "form-select", style = "width:150px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Dependent Eligibility Status: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.EligibilityStatusFilter, "-- All --", new { @class = "form-select", style = "width:150px;" })
    </div>
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="0%">Employee</th>
                    <th width="14%">Name</th>
                    <th width="10%">Gender</th>
                    <th width="10%">Date of Birth</th>
                    <th width="5%">Certificate</th>
                    <th width="5%">Age (Year)</th>
                    <th width="1%"></th>
                    <th width="5%"></th>
                    <th width="10%">Submit Date</th>
                    <th width="10%">Last Update</th>
                    <th width="10%">Status</th>
                    <th width="10%">Remarks</th>
                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })

    @section scripts 
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var enableGrouping = true;
            var table;
            $(document).ready(function () 
            {
                GetAllDataSN(ilaka, "id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "c_name", name: "c_name", autoWidth: false },
                    { data: "gender", name: "gender", autoWidth: false, render: function(data, type, row) { if (data === "M") { return "Male"; } else { return "Female"; } } },
                    { data: "date_of_birth", name: "date_of_birth", autoWidth:  false, render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;} },
                    { data: "dob_file_name", name: "dob_file_name", autoWidth: false, render: function(data, type, row, meta) { if (!data) { return ""; } return getFileType(data, 'DependentDobCDownload', row.id) } },
                    { data: "dependentAge", name: "dependentAge", autoWidth: false },
                    { data: "isReceiptReq", name: "isReceiptReq", autoWidth: false, render: function(data, type, row) { if (!data) { return ""; } if (data === "true") { return '<img src="/images/expiring-soon.gif" title = "Need to upload latest receipt for full time student.">' } else { return "" } } },
                    {
                        data: "receipt", name: "receipt", autoWidth: false,
                        render: function(data, type, row, meta) {
                            return '<a href="#" class="view-receipt" data-id="' + row.id + '"><img src="/images/receipt.png" title = "Receipt"></a>';
                        }
                    },
                    { data: "submit_date", name: "submit_date", autoWidth:  false, render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;} },
                    { data: "update_date", name: "update_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                    { data: "status", name: "status", autoWidth: false, render: function (data, type, row) { if (data === "P") { return "Pending"; } else if (data === "A") { return "Active"; } else if (data === "I") { return "Inactive"; } else { return data; } } },
                    { data: "remarks", name: "remarks", autoWidth: false, render: function (data, type, row) { if (!data) {return "";}return '<span style="white-space: normal; word-wrap: break-word;">' + data + '</span>'; } }
                 ],
                 {
                     FilterValue1: "EmployeeStatusFilter",
                     FilterValue2: "StatusFilter"

                 },
                 "employee"
              );
            });
            document.addEventListener('DOMContentLoaded', function() {
                $('#tblData').on('click', 'a.view-receipt', function(e) {
                    e.preventDefault();
                    ViewReceipt($(this).data('id'));
                });
            });

            function ViewReceipt(id) {
                $("#ModalBody").html("");
                document.getElementById("mode").value = "receipt";
                $.get(ilaka + "Receipt", { id: id, mode: "receipt" }, function(data) {
                    $("#ModalBody").html(data);
                    $("#ModalID .modal-title").text("View");
                    var modal = new bootstrap.Modal(document.getElementById("ModalID"));
                    modal.show();
                }).fail(function(xhr) {
                    showError("Error occured while loading record(s): " + xhr.responseText);
                });
            }
            $(document).on("click", "#tblData .button", function () { ViewData($(this).data("id")); });
            $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});
        </script>
    }
}
@model IEnumerable<OvertimeDashboardGroup>

<div class="form-group p-2">
    <table id="tblTravelToMe" class="display compact nowrap" style="width:100%">
        <thead>
            <tr>
                <th>Overtime Date</th>
                <th>Submit Date</th>
                <th>Total Hours</th>
                <th>Action / Status</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var group in Model)
                {
                    <!-- Employee header row -->
                    <tr class="dashboard-employeename-pending">
                        <td colspan="4">@group.EmployeeName</td>
                    </tr>

                    <!-- Travel rows -->
                    @foreach (var overtime in group.Overtimes)
                    {
                        <tr>
                            <td>@overtime.OtDate.ToString("dd/MM/yyyy")</td>
                            <td>@overtime.SubmitDate.ToString("dd/MM/yyyy")</td>
                            <td>@overtime.TotalHours <br />
                            </td>
                            <td>
                                @Html.Raw(overtime.ActionLinks)
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No data available</td>
                </tr>
            }
        </tbody>
    </table>
</div>


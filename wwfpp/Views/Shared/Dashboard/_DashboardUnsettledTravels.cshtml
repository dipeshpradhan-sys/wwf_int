<div class="form-group p-2">
    <table id="tblDataEmp" class="display compact nowrap" style="width:100%">
        <tbody>
            <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                <th style="background-color:#FFFFFF;width:100%;color:#000000;"><span id="UnsettledContainer"></span></th>
            </tr>

            <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                <th style="background-color:#FFFFFF;width:100%;color:#000000;"><span id="TravelSavedforSettlement"></span></th>
            </tr>

            <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                <th style="background-color:#FFFFFF;width:100%;color:#000000;"><span id="EmployeeContractExpiry"></span></th>
            </tr>
        </tbody>
    </table>
</div>


    <script>
        $(document).ready(function( ) {
            getRecords();
        });
        function getRecords() {
            var empId = $("select#employeeList").val();
            var fiscalYear = $("select#FiscalYearFilter").val();
            $.ajax({
                url: "/Request/GetApprovedTravelList",
                type: 'POST',
                data: { fiscalYear: fiscalYear, settleType: "", pageType: "dashboard" },
                success: function(data) {
                    // Inject the HTML returned by your action
                    $("#UnsettledContainer").html(data);
                },
                error: function() {
                    alert("Error loading travel settlement list.");
                }
            });
            $.ajax({
                url: "/Request/GetApprovedTravelList",
                type: 'POST',
                data: { fiscalYear: fiscalYear, settleType: "T", pageType: "dashboard" },
                success: function(data) {
                    // Inject the HTML returned by your action
                    $("#TravelSavedforSettlement").html(data);
                },
                error: function() {
                    alert("Error loading travel settlement list.");
                }
            });
            $.ajax({
            url: "/Dashboard/ListContractAlert",
                type: 'POST',
                data: { },
                success: function(data) {
                    // Inject the HTML returned by your action
                    $("#EmployeeContractExpiry").html(data);
                },
                error: function() {
                    alert("Error loading travel settlement list.");
                }
            });
        }
    </script>





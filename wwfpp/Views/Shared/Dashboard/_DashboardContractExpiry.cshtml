@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
    <style>
        #tblDataList td, #tblDataList th {
            padding: 15px 10px;
            font-size: 15px;
            height: 15px;
        }
    </style>
    @Html.AntiForgeryToken()
    @Html.Hidden("ilakaContract", "/Dashboard/DashboardContractExpiry")

    <div class="form-group p-2">
        <table id="tblDataContract" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="29%">Employee</th>
                    <th width="20%">Contract Subject</th>
                    <th width="15%">Issue Date</th>
                    <th width="15%">End Date</th>
                    <th width="10%">Status</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })

        <script>
            var table;
            var hideviewaction = "";
            $(document).ready(function() {
                var ilaka = document.getElementById('ilakaContract').value;
                GetAllDataContractSN(ilaka, "emp_contract_id", [
                    { data: "employee", name: "employee", className: "dt-left", autoWidth: false },
                    { data: "document_subject", name: "document_subject", className: "dt-left", autoWidth: false },
                    { data: "issue_date", name: "issue_date", className: "dt-left", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                    { data: "end_date", name: "end_date", className: "dt-left", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                    { data: "contract_status", name: "contract_status", className: "dt-left", autoWidth: false, render: function(data, type, row) { if(data === "A") {return "Active";} else {return "Inactive";} }}
                ]
                );
            });
        </script>

@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Users.UsersViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Users";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/

}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Users/Users")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")
@Html.Hidden("hStatus", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<div class="row">
    <div class="col-lg-2"><label class="col-form-label-lg">Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll"></th>
                    <th width="20%">Username</th>
                    <th width="25%">Level</th>
                    <th width="29%">Employee</th>
                    <th width="10%">Status</th>
                    <th width="15%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody" })
    @section scripts 
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            otherButtons = "";
            var table;
            $(document).ready(function () 
            {
                GetAllData(ilaka, "user_id", [
                    { data: "username", name: "username", autoWidth: false },
                    { data: "level_name", name: "level_name", autoWidth: false },
                    { data: "emp_name_code",name: "emp_name_code", render: function (data, type, row) {return [row.firstname, row.middlename, row.lastname].filter(x => x).join(" ") + " (" + row.emp_code + ")";},autoWidth: false},
                    { data: "is_active", name: "is_active", autoWidth: false, render : function(data, type, row ){ switch (data) {case "Y": return "Active";case "N": return "Inactive";default: return data;}}}
                ],{FilterValue: "StatusFilter"});
                $("#StatusFilter").off("change").on("change", function () {const statusV = $(this).val();if (!statusV) {return;}const $myButton =  $("#btnActDact");if ($myButton.length) {if(statusV === "Y"){$myButton.text("Deactivate").removeClass("bg-blue").addClass("bg-org");} else {$myButton.text("Activate").removeClass("bg-org").addClass("bg-blue");}}table.draw();});
                $(document).on("click", "#tblData .button", function () {ViewData($(this).data("id"));});
                $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});
                $(document).off('click', '#btnActDact').on('click', '#btnActDact', function () {updateStatus(ilaka+'UpdateStatus',$(this).text());});
            });
        </script>
    }
}
@model wwfpp.Models.Users.GuardViewModel
@{
    string mode = ViewBag.mode;
}
<!-- (A) HTML DIALOG BOX -->
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
    @Html.HiddenFor(m => m.pk_user_id) <!-- Needed for Edit -->
    <div class="form-group row p-1">

        <label class="col-lg-12 col-form-label-lg">User Name<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.TextBoxFor(m => m.user_name, new { @class = "form-control", maxlength = "50" })
        </div>
    
        <label class="col-lg-12 col-form-label-lg">User Pass<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.TextBoxFor(m => m.user_pass, new { @class = "form-control", maxlength = "20" })
        </div>
        
        <label class="col-lg-12 col-form-label-lg">Full Name<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.TextBoxFor(m => m.full_name, new { @class = "form-control", maxlength = "250" })
        </div>
        
        <label class="col-lg-12 col-form-label-lg">Status<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.DropDownListFor(m => m.is_active, (SelectList)ViewBag.is_active, "--Select--", new {@class = "form-select",style = "width:300px;" })
        </div>

        <label class="col-lg-12 col-form-label-lg">User Type<span class="text-danger">*</span></label>
        <div class="col-lg-12">
        @Html.DropDownListFor(m => m.user_type, (SelectList)ViewBag.user_type, "--Select--", new {@class = "form-select",style = "width:300px;" })
        </div>
    </div>

@if (mode == "add" && ViewBag.apern == "true")
{
    <script>renderModalButtons("modal-button-list", "Save");</script>
}
else if (mode == "edit" && ViewBag.epern == "true")
{
    <script>renderModalButtons("modal-button-list", "Edit");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list")</script>
}
    <script>
    // Toggle between Edit and Update
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text() == "Edit") {$("#ModalID .modal-title").text("Update");btn.text("Update");$("#btnC").text("Cancel");return;}  
        if (btn.text() === "Update" || btn.text() === "Save") {

            if ( checkInput( 'txt', 'user_name', 'User Name is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'user_pass', 'Password is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'full_name', 'Full Name is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'is_active', 'Status is required.', 'modal-message') == false ) {return false;}
            if ( checkInput( 'txt', 'user_type', 'User Type is required.', 'modal-message') == false ) {return false;}
            submitSaveUpdate('@Url.Content("~/Users/Guard")');
        }
    });
    </script>
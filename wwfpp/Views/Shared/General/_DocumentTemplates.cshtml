@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.General.DocumentTemplatesViewModel>
@{
    Layout = "~/Views/Shared/_Layout_form_enc.cshtml";
    var PageTitle = "Document Templates";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/General/DocumentTemplates")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")
@Html.Hidden("hStatus", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%"><input type="checkbox" id="selectAll"></th>
                    <th width="39%">Document Title</th>
                    <th width="15%">Document Version</th>
                    <th width="15%">Upload Date</th>
                    <th width="10%">Status</th>
                    <th width="10%">File</th>
                    <th width="10%">Action</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })
    @section scripts 
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var table;
            $(document).ready(function () {GetAllData(ilaka, "id", [
                    { data: "document_title", name: "document_title", autoWidth: false },
                    { data: "document_version", name: "document_version", autoWidth: false },
                    { data: "upload_date", name: "upload_date", autoWidth: false,render: function (data, type, row) {if (type === 'display' || type === 'filter') {return moment(data).format(my_format);}return data;}},
                    { data: "status", name: "status", autoWidth: false},
                    { data: "upload_file", name: "upload_file", autoWidth: false,render: function (data, type, row, meta) { return getFileType(data, 'DocumentTemplatesDownload', row.id)}},
                ],{FilterValue: "StatusFilter"});});
            $("#StatusFilter").off("change").on("change", function () {const statusV = $(this).val();if (!statusV) {return;}const $myButton =  $("#btnActDact");if ($myButton.length) {if(statusV === "A"){$myButton.text("Deactivate").removeClass("bg-blue").addClass("bg-org");} else {$myButton.text("Activate").removeClass("bg-org").addClass("bg-blue");}}table.draw();});
            $(document).on("click", "#tblData .button", function () {ViewData($(this).data("id"));});
            $(document).off('click', '#btnC').on('click', '#btnC', function () {modalCloseCancel($(this));});
        </script>
    }
}
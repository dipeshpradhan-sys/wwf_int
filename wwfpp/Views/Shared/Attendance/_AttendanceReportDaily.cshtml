@using wwfpp.Models.Attendance
@model List<ReportDailyAttendanceMainViewModel>
<table class="table table-bordered">
    <thead>
        <tr>
            <th class="bg-gray">Report Title:</th>
            <th>@ViewBag.ReportTitle</th>
        </tr>
        @if (!string.IsNullOrWhiteSpace(@ViewBag.DutyStation))
        {
        <tr>
            <th class="bg-gray">Duty Station:</th>
            <th>@ViewBag.DutyStation</th>
        </tr>
        }
        @if (!string.IsNullOrWhiteSpace(@ViewBag.EmployeeType))
        {
        <tr>
            <th class="bg-gray">Employee Type:</th>
            <th>@ViewBag.EmployeeType</th>
        </tr>
        }
        @if (!string.IsNullOrWhiteSpace(@ViewBag.ReportType))
        {
            <tr>
                <th class="bg-gray">Report Type:</th>
                <th>@ViewBag.ReportType</th>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(@ViewBag.InOutDate))
        {
            <tr>
                <th class="bg-gray">Date:</th>
                <th>@ViewBag.InOutDate</th>
            </tr>
        }
    </thead>
</table>

<table class="table table-bordered">
    <thead>
        <tr class="bg-gray">
            <th>Employee</th>
            <th>First Check-In</th>
            <th>Last Check-Out</th>
            <th>Late to Office</th>
            <th>Late to Home</th>
            <th>Remarks</th>
            <th>Narration</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    @if (Model == null || !Model.Any())
    {
        <tr>
            <td colspan="8" class="text-center">No records found.</td>
        </tr>
    }
    else
    {
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.employee</td>
                <td>@item.first_check_in</td>
                <td>@item.last_check_out</td>
                <td>@item.late_to_office</td>
                <td>@item.late_to_home</td>
                <td>@item.remarks</td>
                <td>@item.narration</td>
                <td>@item.status</td>
            </tr>

            @if (item.SubDetails != null && item.SubDetails.Any())
            {
                <tr>
                    <td colspan="8">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Check-In</th>
                                    <th>Check-Out</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in item.SubDetails)
                                {
                                    <tr>
                                        <td>@sub.check_in</td>
                                        <td>@sub.check_out</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        }
      }
    </tbody>
</table>
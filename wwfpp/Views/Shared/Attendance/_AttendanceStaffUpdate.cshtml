@using Microsoft.AspNetCore.Http;
@using wwfpp.Services;
@inject SettingsServices SettingsServices;
@inject AttendanceServices AttendanceServices;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Attendance.DailyCheckInOutStaffUpdateViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Attendance - Today's Staff Update";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/

    string DATE_FORMAT = ViewBag.DATE_FORMAT;
    string in_out_date = ViewBag.InOutDay.ToString();
    string s_in_out_date = SettingsServices.DateformatToDt(in_out_date);
    string fullWidth = "12";
    string strButton = "";
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Attendance/AttendanceStaffUpdate")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Today: &nbsp;</label></div>
    <div class="col-lg-9">
        <div class="row col-lg-12">
            <div class="col-lg-4">@Html.TextBox("in_out_date", s_in_out_date, new { @class = "form-control", maxlength = "10", style = "width:200px;", @Readonly = "readonly" })</div>
            <div class="col-lg-8 lblue">&nbsp;</div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Duty Station: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("DutyStationFilter", (SelectList)ViewBag.DutyStationFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Type: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeTypeFilter", (SelectList)ViewBag.EmployeeTypeFilter, "-- Select --", new { @class = "form-select", style = "width:300px;" })
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(ViewBag.sendButton))
{
    strButton = $@"<div class=""col-1 d-flex justify-content-end align-items-center"">"+ ViewBag.sendButton +"</div>";
    fullWidth = "11";
}
@if (!string.IsNullOrWhiteSpace(ViewBag.showSentMessage))
{
    <div class="row" style="height:50px;">
        <div class="col-@fullWidth col-form-label-sm" style="display:flex; align-items:center; padding-left:10px;">
            <div class="@ViewBag.messageColor col-12 col-form-label-sm">@ViewBag.showSentMessage</div>
        </div>
        @Html.Raw(strButton)
    </div>
}

@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 50px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="29%">Employee</th>
                    <th width="20%">Remarks</th>
                    <th width="40%">Narration</th>
                    <th width="10%">Status</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>

    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var hideviewaction = "yes";
            $(document).ready(function ()
            {
                var table;
                GetAllDataSN(ilaka, "emp_id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "remarks", name: "remarks", autoWidth: false },
                    { data: "narration", name: "narration", autoWidth: false },
                    { data: "status", name: "status", autoWidth: false }
                ],
                {
                    FilterValue1 : "in_out_date",
                    FilterValue2 : "DutyStationFilter",
                    FilterValue3 :"EmployeeTypeFilter"
                });
                // Wait for first draw to complete before changing page length
                $('#tblData_filter').hide();
                $('#tblData_length').hide();
            });
            $(document).off("click", "#btnSendNow").on("click", "#btnSendNow", function() {

                if (confirm(msg_are_you_sure_to_perform_this_action)) {
                    $("#mode").val("send");
                    $.ajax({
                        type: "POST",
                        url: ilaka + "SendNow",
                        data: JSON.stringify({ in_out_date: $("#in_out_date").val(), duty_station_id: $("#DutyStationFilter").val() }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                        success: function(data) {
                            if (data.status) {
                                showSuccess(data.message);
                               } else {
                                showError("Error: " + data.message);
                            }
                        },
                        error: function(xhr, status, error) { showError("Request failed: " + error); }
                    });
                }
            });
        </script>
    }
}

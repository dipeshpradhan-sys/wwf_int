@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model wwfpp.Models.Attendance.EmployeeCheckInOutSettingViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Attendance - Staff Update Settings";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Attendance/StaffUpdateSettings")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", (string)ViewBag.mode)

<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="form-group row p-1">
    @Html.HiddenFor(m => m.id)

    <div class="row" style="height:50px;">
        <div class="col-lg-3 col-form-label-sm">Send staff update everyday?<span class="text-danger">*</span></div>
        <div class="col-lg-9">
            @Html.DropDownList("send_staff_update", (SelectList)ViewBag.SendStaffUpdate, new
                {
                    @class = "form-select"
                })
        </div>
    </div>

    <div class="row" style="height:50px;">
        <div class="col-lg-3 col-form-label-sm">Staff update time<span class="text-danger">*</span></div>
        <div class="col-lg-3">
            @Html.DropDownList("send_hrs_min", (SelectList)ViewBag.SendHoursMinutes, new
            {
                @class = "form-select"
            })
        </div>
        <div class="col-lg-3">
            @Html.DropDownList("send_am_pm", (SelectList)ViewBag.SendAMPM, new
            {
                @class = "form-select"
            })
        </div>
        <div class="col-lg-3">&nbsp;</div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-form-label-sm">Except following dates:</div>
        <div class="col-lg-9">
            @Html.TextAreaFor(m => m.send_off_days, new { @class = "form-control", rows = "4", cols = "50", maxlength = "250" })
        </div>
    </div>

    <div class="row" style="height:50px;">
        <div class="col-lg-3 col-form-label-sm">&nbsp;</div>
        <div class="col-lg-9 col-form-label-sm">
            Provide date in @ViewBag.DATE_FORMAT Format with Comma (,) or Semicolon (;) to separate dates eg: 06/20/2020,06/21/2020 or 06/20/2020;06/21/2020
        </div>
    </div>
</div>
@if (ViewBag.apern == "true" || ViewBag.epern == "true")
{
    <div class="form-group row p-1">
        <label class="col-sm-4 col-form-label">&nbsp;</label>
        <div class="col-sm-8">
            <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
            <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
        </div>
    </div>

    @section scripts
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;

            $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
                if ( checkInput( 'cmb', 'send_staff_update', 'Send staff update everyday? is required') == false ) {return false;}
                if ( checkInput( 'cmb', 'send_hrs_min', 'Staff update time is required.') == false ) {return false;}
                if ( checkInput( 'cmb', 'send_am_pm', 'Staff update time is required.') == false ) {return false;}
                submitSaveUpdate(ilaka);
            });
        </script>
    }
}

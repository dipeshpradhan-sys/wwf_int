@model ApprovalFromEmailVM
<div id="ModalForm">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.EmpID) <!-- Needed for Edit -->
    @Html.HiddenFor(m => m.AppID)
    @Html.HiddenFor(m => m.ToID)
    @Html.HiddenFor(m => m.ToEmpID)
    @Html.HiddenFor(m => m.St)
    @Html.HiddenFor(m => m.Counter)
    @Html.HiddenFor(m => m.Month)
    @Html.HiddenFor(m => m.Year)
    @Html.HiddenFor(m => m.ApproveFor)
    @Html.HiddenFor(m => m.Token)
    @Html.Hidden("ActionVia", "dashboard")

    <div class="form-group row p-1">
        <label class="col-sm-4 col-form-label"></label>
        <div class="col-sm-8">
            <div class="input-group input-group-sm">
                <textarea asp-for="Description" rows="5" cols="50" class="form-control" placeholder="Enter Description"></textarea>
            </div>
        </div>
    </div>
</div>
<script>renderModalButtons("modal-button-list", "Save");</script>
@section scripts {
    <partial name="_ValidationScriptsPartial.cshtml" />
}
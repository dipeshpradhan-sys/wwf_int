        $(document).on("blur", "input[type=number]", function () {
            let val = $(this).val();
            if (val < 0 || val.length > 10) {
                showError("Invalid input: must be positive and up to 10 digits.");
                $(this).val(""); // reset
            }
        });
        $(document).off("click", "#btnSave").on("click", "#btnSave", function () { $("#mode").val("update"); updateDataJSON(ilaka + "Save"); });
        $(document).off('click', '#btnDownLoadFormat').on('click', '#btnDownLoadFormat', function () { postdata(ilaka + 'DownloadFormat'); });
        $(document).off('click', '#btnImport').on('click', '#btnImport', function () {
            $("#modal-message").text("").hide();
            $("#ModalBody").html("");
            var _year = $("#YearFilter").val();
            var _month = $("#MonthFilter").val();
            $.get(ilaka + "Import", { sal_year: _year, sal_month: _month }, function (data) {
                $("#ModalBody").html(data);
                $("#ModalID .modal-title").text("Import");
                var modal = new bootstrap.Modal(document.getElementById("ModalID"));
                modal.show();
            }).fail(function (xhr) { showError("Error occured while loading record(s): " + xhr.responseText); });
        });
        function collectExtraFields() {
            var extraSettings = [];
            $("#tblData tbody tr").each(function () {
                var row = $(this);
                var id = row.find("input.row-checkbox:checked").val();
                if (selectedIds.has(id)) {
                    extraSettings.push({
                        emp_id: parseInt(id, 10),
                        sal_year: $("#YearFilter").val() || 0,
                        sal_month: $("#MonthFilter").val() || 0,
                        act_basic_salary: row.find("input[name^='act_basic_salary']").val(),
                        act_pf_a: row.find("input[name^='act_pf_a']").val(),
                        act_pf_d: row.find("input[name^='act_pf_d']").val(),
                        a_cit_d: row.find("input[name^='a_cit_d']").val(),
                        act_remote_area_all: row.find("input[name^='act_remote_area_all']").val(),
                        basic_salary: row.find("input[name^='basic_salary']").val(),
                        pf_a: row.find("input[name^='pf_a']").val(),
                        children_edu_all: row.find("input[name^='children_edu_all']").val(),
                        performance_all: row.find("input[name^='performance_all']").val(),
                        remote_area_all: row.find("input[name^='remote_area_all']").val(),
                        overtime: row.find("input[name^='overtime']").val(),
                        dashain_a: row.find("input[name^='dashain_a']").val(),
                        gratuity: row.find("input[name^='gratuity']").val(),
                        ssf: row.find("input[name^='ssf']").val(),
                        annual_health_checkup_add: row.find("input[name^='annual_health_checkup_add']").val(),
                        annual_health_checkup_add: row.find("input[name^='annual_health_checkup_add']").val(),
                        insurance: row.find("input[name^='insurance']").val(),
                        others: row.find("input[name^='others']").val(),
                        medical_expense_reimburse_total: row.find("input[name^='medical_expense_reimburse_total']").val(),
                        leave_encash: row.find("input[name^='leave_encash']").val(),
                        pf_d: row.find("input[name^='pf_d']").val(),
                        cit_d: row.find("input[name^='cit_d']").val(),
                        gratuity_ded: row.find("input[name^='gratuity_ded']").val(),
                        ssf_ded: row.find("input[name^='ssf_ded']").val(),
                        annual_health_checkup_ded: row.find("input[name^='annual_health_checkup_ded']").val(),
                        pre_access_tax: row.find("input[name^='pre_access_tax']").val(),
                        incometax_d: row.find("input[name^='incometax_d']").val(),
                        tel_per_adv: row.find("input[name^='tel_per_adv']").val(),
                        travel_prog_adv: row.find("input[name^='travel_prog_adv']").val(),
                        pr_adv: row.find("input[name^='pr_adv']").val(),
                        fd_adv: row.find("input[name^='fd_adv']").val(),
                        welfare_fund: row.find("input[name^='welfare_fund']").val(),
                        adv_pf_loan: row.find("input[name^='adv_pf_loan']").val(),

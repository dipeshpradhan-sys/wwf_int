@{
    short wlYear = @ViewBag.wl_year;
    short wlMonth = @ViewBag.wl_month;
    string wlMonthName = @ViewBag.wlMonthName;
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
<label class="col-lg-12 col-form-label-lg">Year: @ViewBag.wl_year @Html.Hidden("wl_year", wlYear)</label>
<label class="col-lg-12 col-form-label-lg">Month: @ViewBag.wlMonthName @Html.Hidden("wl_month", wlMonth)</label>

<div class="form-group row p-1">
    <label class="col-lg-12 col-form-label-lg">Select CSV file (*.csv)<span class="text-danger">*</span>&nbsp;</label>
    <div class="col-lg-12">
        @Html.TextBox("file", "", new { type = "file" })
    </div>
</div>

@if (ViewBag.epern == "true")
{
    <script>renderModalButtons("modal-button-list", "Upload");</script>
}
else
{
    <script>renderModalCloseButton("modal-button-list");</script>
}
<script>
    $(document).off("click", "#btnSave").on("click", "#btnSave", function () {
        var btn = $(this);
        if (btn.text().trim() === "Upload") {
            if ($("#file").val() === "") {
                showError('Welfare Interest Import file is required.', 'modal-message'); return false;
            }
            submitSaveUpdateUpload("/Payroll/WelfareInterestImport");
        }
    });
    $(document).off("click", "#btnC").on("click", "#btnC", function () {
        $('#tblData').DataTable().ajax.reload();
        var modal = bootstrap.Modal.getInstance(document.getElementById("ModalID")); modal.hide();
    });
</script>
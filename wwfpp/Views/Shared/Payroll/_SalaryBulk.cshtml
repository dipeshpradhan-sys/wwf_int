        new { @class = "form-select me-4", style = "width:150px;" })

    <label class="me-2">Month:</label>
    @Html.DropDownList("MonthFilter", (SelectList)ViewBag.MonthDropDown,
        new { @class = "form-select me-4", style = "width:150px;" })


@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Overtime Bulk";
    var Page_Tips = "After submission of salary the overtime can not be modified. In case of modification needed, first need to delete the salary sheet.";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}

@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="d-flex align-items-center">
    <label class="me-2">Status:</label>
    @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter,
        new { @class = "form-select me-4", style = "width:150px;" })
    <label class="me-2">Year:</label>
    @Html.DropDownList("YearFilter", (SelectList)ViewBag.YearDropDown,
        new { @class = "form-select me-4", style = "width:150px;" })

    <label class="me-2">Month:</label>
    @Html.DropDownList("MonthFilter", (SelectList)ViewBag.MonthDropDown,
        new { @class = "form-select me-4", style = "width:150px;" })
</div>

<div id="message_header"><p id="process-message" class="note"></p></div>

<div class="form-group p-2">
    <table id="tblData" class="display compact nowrap" style="width:100%">
        <thead>
            <tr style="background-color:silver; height:40px;">
                <th></th>
                <th>Employee<input type="hidden" id="isCalculated" value="0" /></th>
                <th>Basic</th>
                <th></th>
                <th></th>
                <th>Period</th>
                <th colspan="9" class="text-center">Overtime Detail</th>
            </tr>
            <tr style="background-color:silver; height:40px;">
                <th width="1%">S.N.</th>
                <th width="10%">Name(ID)</th>
                <th width="10%">Salary</th>
                <th width="9%">Times</th>
                <th width="10%">Hours</th>
                <th width="10%">Rate</th>
                <th width="10%">Hour(s)</th>
                <th width="10%">Amount</th>
                <th width="10%">Difference</th>
                <th width="10%">Total</th>
                <th width="10%">Remarks</th>
            </tr>
        </thead>
    </table>
</div>

<div id="message_header">@Html.Raw(ShowMsg)</div>

<div id="btnotbulk" class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">      
            <div class="d-flex gap-2">
            @if (ViewBag.epern == "true")
            {
                    <div id="saveSection" class="d-flex gap-2">
                        <button type="button" id="btnCalculate" class="button btn-primary"> Calculate All</button>
                        <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
                   </div>
            }
            @if (ViewBag.dpern == "true")
            {
                <div id="clearSection" class="d-flex gap-2">
                    <button type="button" id="btnClear" class="button btn-danger">Clear</button>
                </div>
            }
            <button type="button" id="btnReset" class="button bg-dgray">Reset</button>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        var ilaka = "/Payroll/OvertimeBulk";
        var selectedIds = new Set();
        var hideviewaction = "yes";
        var table;
        $(document).ready(function ()
        {
           table= GetAllDataSN(ilaka, "emp_id", [
                { data: "fullName", name: "FullName", autoWidth: false, render: function (data, type, row) {return data ;}},
                { data: "basicSalary", name: "BasicSalary", autoWidth: false, render: function (data, type, row, meta) {return data +'<input type="hidden" name="empid_' + row.emp_id + '" value="' + row.emp_id + '"><input type="hidden" name="basic_salary_' + row.emp_id +'" id="basic_salary_' + row.emp_id +'" value="' + data + '" class="form-control times-input" style = "width:90px;", maxlength = "10">' ;}},
                { data: "times", name: "Times", autoWidth: false, render: function(data, type, row, meta) {return '<input type="number" name="times_' + row.emp_id +'" id="times_' + row.emp_id +'" value="' + data + '" class="form-control times-input" style = "width:70px;", maxlength = "10">';}},
                { data: "periodHours", name: "PeriodHours", autoWidth: false, render: function(data, type, row, meta) {return '<input type="number" name="periodHours_' + row.emp_id +'" id="periodHours_' + row.emp_id +'" value="' + data + '" class="form-control periodHours-input" style = "width:70px;", maxlength = "10">';}},
                { data: "rate", name: "Rate", autoWidth: false, render: function(data, type, row, meta) {return '<input type="text" name="rate_' + row.emp_id +'" id="rate_' + row.emp_id +'" value="' + data + '" class="form-control rate-input" style = "width:80px;", maxlength = "10" readonly>';}},
                { data: "hrs", name: "Hrs", autoWidth: false, render: function(data, type, row, meta) {return '<input type="text" name="hrs_' + row.emp_id +'" id="hrs_' + row.emp_id +'" value="' + data + '" class="form-control hrs-input" style = "width:80px;", maxlength = "10" readonly>';}},
                { data: "amount", name: "Amount", autoWidth: false, render: function(data, type, row, meta) {return '<input type="number" name="amount_' + row.emp_id +'" id="amount_' + row.emp_id +'" value="' + data + '" class="form-control amount-input" style = "width:120px;", maxlength = "10" readonly>';}},
                { data: "difference", name: "difference", autoWidth: false,
                  render: function(data, type, row, meta) {
                      if (row.isDiffMonth === "Y") {
                          // enabled textbox, maxlength=10
                          return '<input type="text" inputmode="numeric" pattern="\d{1,10}" name="difference_' + row.emp_id + '" id="difference_' + row.emp_id + '" value="' + data + '" class="form-control difference-input" style="width:90px;" maxlength="10">';
                      } else {
                          // readonly textbox, maxlength=0
                          return '<input type="number" name="difference_' + row.emp_id + '" id="difference_' + row.emp_id + '" value="' + data + '" class="form-control difference-input" style="width:90px;" maxlength="0" readonly>';
                      }
                  }
                },                
                { data: "total", name: "Total", autoWidth: false, render: function(data, type, row, meta) {return '<input type="number" name="total_' + row.emp_id +'" id="total_' + row.emp_id +'" value="' + data + '" class="form-control total-input" style = "width:120px;", maxlength = "10" readonly>';}},
                { data: "remarks", name: "Remarks", autoWidth: false, render: function(data, type, row, meta) {return '<input type="text" name="remarks_' + row.emp_id +'" id="remarks_' + row.emp_id +'" value="' + data + '" class="form-control remarks-input" style = "width:120px;", maxlength = "200">';}}
            ],
            {
                Status: "StatusFilter",
                Year: "YearFilter",
                Month: "MonthFilter"
            });
            // Explicitly get the DataTable API object
            table = $('#tblData').DataTable();

            $(document).one('init.dt', '#tblData', function () {
                table.page.len(-1).draw();             // set page length to "All"
            });
            $('#tblData_filter').hide();
            $('#tblData_length').hide();

            // Attach xhr event to the DataTable API object
            table.one('xhr.dt', function(e, settings, json) {
                if (json) {
                    var total = json.recordsTotal;
                    if (total > 0) {
                        $('#btnotbulk').show();
                    } else {
                        $('#btnotbulk').hide();
                    }
                }
            });
            table.on('draw.dt', function() {
                var blnShowSave = table.ajax.json().blnShow; // get from last JSON
                if (blnShowSave === true) {
                    showError(msg_cant_edit_overtime_salary_processed, "process-message");
                    $('#btnSave').hide();
                    $('#btnCalculate').hide();
                    $('#btnClear').hide();
                } else {
                    $('#process-message').hide();
                    $('#btnSave').show();
                    $('#btnCalculate').show();
                    $('#btnClear').show();
                }
            });
            document.addEventListener("input", function(e) {
                if (e.target.classList.contains("difference-input")) {
                    // Remove non-digits
                    e.target.value = e.target.value.replace(/\D/g, '');
                    // Enforce max length 10
                    if (e.target.value.length > 10) {
                        e.target.value = e.target.value.slice(0, 10);
                    }
                }
            });
        });

        function collectExtraFields() {
            var extraSettings = [];
            $("#tblData tbody tr").each(function () {
                var row = $(this);
                var id = row.find("input.row-checkbox:checked").val();
                if (selectedIds.has(id)) {
                    extraSettings.push({
                        emp_id: parseInt(id, 10),
                        basicSalary: row.find("input[name^='basic_salary']").val(),
                        times: row.find("input[name^='times']").val(),
                        rate: row.find("input[name^='rate']").val(),
                        hrs: row.find("input[name^='hrs']").val(),
                        remarks: row.find("input[name^='remarks']").val(),
                        difference: row.find("input[name^='difference']").val(),
                        sal_year:  $("#YearFilter").val() || 0,
                        sal_month: $("#MonthFilter").val() || 0,
                    });
                }
            });
            return extraSettings;
        }
        $("#btnSave").on("click", function () {
            if ($("#isCalculated").val() === "0") {
                showError(msg_calculate_before_save);
                return;
            }
            if (!confirm(msg_are_you_sure_to_perform_this_action)) {
                return;
            }
            $.ajax({
                url: ilaka+'Save',
                type: 'POST',
                data: $("#tblData input").serialize()
                      + "&Year=" + $("#YearFilter").val()
                      + "&Month=" + $("#MonthFilter").val()
                      + "&__RequestVerificationToken=" + $('input[name="__RequestVerificationToken"]').val(),
                success: function (res) {
                    $("#isCalculated").val("0");
                    if (!res.success) {
                        showError(res.message);
                        return;
                    }
                    showSuccess(res.message);
                    $("#tblData").DataTable().ajax.reload();
                }
            });
        });
        $("#btnClear").on("click", function () {
            if (!confirm(msg_are_you_sure_to_perform_this_action)) {
                return;
            }
            $.ajax({
                url: ilaka+'Clear',
                type: 'POST',
                data: {
                    Year: $("#YearFilter").val(),
                    Month: $("#MonthFilter").val(),
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (res) {
                    if (res.success) {
                        $("#isCalculated").val("0");
                        showSuccess(res.message);
                        $("#tblData").DataTable().ajax.reload();
                    }
                }
            });
        });

        function calculateEmployeeOvertimeBulk() {
            var cnt = 0;
            $("#tblData tbody tr").each(function () {
                let $tr = $(this);

                let basicSalary = parseFloat($tr.find("input[name^='basic_salary']").val()) || 0;
                let times       = parseFloat($tr.find("input[name^='times']").val()) || 0;
                let hrs         = parseFloat($tr.find("input[name^='hrs']").val()) || 0;
                let ot_diff     = parseFloat($tr.find("input[name^='difference']").val()) || 0;
                let dhrs        = parseFloat($tr.find("input[name^='periodHours']").val()) || 1;
                let rate = 0, amount = 0, t_amount = 0;
                if (hrs !== 0) {
                    rate   = basicSalary * times / dhrs;
                    amount = rate.toFixed(0) * hrs;
                    cnt++;
                }
                t_amount = amount + ot_diff;

                $tr.find("input[name^='rate']").val(rate.toFixed(0));
                $tr.find("input[name^='amount']").val(amount.toFixed(0));
                $tr.find("input[name^='total']").val(t_amount.toFixed(0));
            });
            $("#isCalculated").val(cnt); // mark as calculated
        }

        $("#btnCalculate").on("click", function () {
            calculateEmployeeOvertimeBulk();
        });

        $("#btnReset").on("click", ResetEmployeeOvertimeBulk);
        function ResetEmployeeOvertimeBulk() {
            $("#tblData").DataTable().ajax.reload();
            $("#isCalculated").val("0");
        }
    </script>
}
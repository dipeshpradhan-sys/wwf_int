@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Excess Leave Encashment";
    var Page_Tips = "The Amount will be populated after Leave encash amount saved on Salary Bulk.<br><br>Save button will not display if entire employee's amount are zero.";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    var Pern = ViewBag.vpern;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());

}
@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("blnShow", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
<div class="d-flex align-items-center justify-content-between">
    <div class="d-flex align-items-center">
        <label class="me-2">Fiscal Year:</label>
        @Html.DropDownList("FiscalYearFilter", (SelectList)ViewBag.FiscalYearList,
            new { @class = "form-select me-4", style = "width:150px;" })
    </div>

    <!-- New div aligned to the right -->
    <div id="msg-processed"></div>
</div>

<!-- Controls row under the header -->
@if (ViewBag.apern == "true" || ViewBag.epern == "true")
{
    <div id="saveSection" class="p-0 bg-white rounded mb-3" style="display:none;">
        <div class="row align-items-center">
            <!-- Right side: Buttons -->
            <div class="col-auto ms-auto">
                <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
            </div>
        </div>
    </div>
}
    <div id="deleteSection" class="p-0 bg-white rounded mb-3" style="display:none;">
        <div class="row align-items-center">
            <!-- Right side: Buttons -->
            <div class="col-auto ms-auto">
                <button type="button" name="btnExport" id="btnExport" class="button btn-primary">Export</button>
                <button type="button" name="btnCCD" id="btnCCD" class="button btn-primary">Cost Center Distribution</button>
                @if (ViewBag.dpern == "true")
                {
                    <button type="button" name="btnClear" id="btnClear" class="button btn-primary">Clear</button>
                }
        </div>
        </div>
    </div>

<!-- DataTable -->
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <div id="message_header"><p id="process-message" class="note"></p></div>
    <div class="form-group p-2">
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="height: 40px; align-items: center;color:white;" class="bg-secondary bg-opacity-27">
                    <th width="1%">SN</th>
                    <th width="49%">Employee Name</th>
                    <th width="10%">Employee ID</th>
                    <th width="10%">Amount</th>
                    <th width="30%">Remarks</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data dynamically injected here -->
            </tbody>
        </table>
    </div>

    <!-- Modal for Add/Edit -->
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

    @section scripts 
    {
        <script>
            var ilaka = "/Payroll/ExcessLeaveEncashment";
            var selectedIds = new Set();
            var hideviewaction = "yes";
            var table;
            $(document).ready(function () 
            {
                GetAllDataSN(ilaka, "emp_id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    { data: "emp_code", name: "emp_code", autoWidth: false },
                    { data: "amount", name: "amount", autoWidth: false, render: function(data, type, row, meta) { return '<input type="text" name="amount_' + row.emp_id + '" id="amount_' + row.emp_id + '" value="' + data + '" class="form-control rate-input" style="width:120px;" readonly>'; } },
                    { data: "remarks", name: "remarks", autoWidth: false, render: function(data, type, row, meta) { return '<input type="text" name="remarks_' + row.emp_id + '" id="remarks_' + row.emp_id + '" value="' + data + '" class="form-control rate-input" style="width:300px;"><input type="hidden" name="counter_' + meta.row + '" id="counter_' + meta.row + '" value="' + row.period + '"><input type="hidden" name="emp_id_' + meta.row + '" id="emp_id_' + meta.row + '" value="' + row.emp_id + '">'; } },
                ],
                    {
                        fiscalYearFilter: "FiscalYearFilter",
                    });

                table = $('#tblData').DataTable();

                // Set page length to "All" after initialization
                $(document).one('init.dt', '#tblData', function() {
                    table.page.len(-1).draw();
                });

                table.on('draw.dt', function() {
                    var blnShowSave = table.ajax.json().blnShow; // get from last JSON
                    if (blnShowSave == false) {
                        $("input[name^='amount_']").prop("readonly", true);
                        $("input[name^='remarks_']").prop("readonly", false);
                        $('#saveSection').show();
                        $('#deleteSection').hide();
                    } else {
                        $("#tblData input[type='text'], #tblData input[type='text']").prop("readonly", true);
                        $('#saveSection').hide();
                        $('#deleteSection').show();
                    }
                    $("#blnShow").val(blnShowSave);
                    if (blnShowSave == true) {
                        showSuccess("The excess leave encash distribution for the period has already been processed.", "process-message");
                    } else {
                        showError("The excess leave encash distribution for the period has not been processed yet.", "process-message");
                    }
                });
            });
            function collectExtraFields() {
                var extraSettings = [];
                $("#tblData tbody tr").each(function() {
                    var row = $(this);
                    extraSettings.push({
                        emp_id: row.find("input[name^='emp_id']").val(),
                        fiscal_year: $("#FiscalYearFilter").val(),
                        amount: row.find("input[name^='amount_']").val(),
                        total_hours: 0,
                        remarks: row.find("input[name^='remarks_']").val()
                    });
                });
                return extraSettings;
            }

            $(document).off("click", "#btnSave").on("click", "#btnSave", function() { $("#mode").val("update"); updateDataNoChk(ilaka + "Save"); });

            $(document).off("click", "#btnClear").on("click", "#btnClear", function () {
                if (!confirm(msg_are_you_sure_to_clear)) {
                    return;
                }

                $.ajax({
                    url: '/Payroll/ExcessLeaveEncashmentClear',
                    type: 'POST',
                    data: {
                        fiscalYear: $("#FiscalYearFilter").val(),
                        period: 1,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        if (res.status === "success") {
                            $('#message').removeClass().addClass('success').html(msg_excess_leave_encashment_cleared_scuccessfully).show();
                        } else {
                            $('#message').removeClass().addClass('error').html(err_in_process + res.message).show();
                        }
                        $("#tblData").DataTable().ajax.reload();
                    },
                    error: function (xhr, status, error) {
                        $('#message').removeClass().addClass('error').html(err_in_process + error).show();
                    }
                });
            });

            $(document).off("click", "#btnExport").on("click", "#btnExport", function () {
                $.ajax({
                    url: '/Payroll/ExportExcessLeaveEncash',
                    type: 'POST',
                    data: {
                        fiscalYear: $("#FiscalYearFilter").val(),
                        period: 1,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        if (res.status === "success") {
                            // Create download link dynamically
                            var link = document.createElement('a');
                            link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + res.fileContent;
                            link.download = res.fileName;
                            link.click();
                            $('#message').removeClass().addClass('success').html(msg_data_exported_success).show();
                            $("#tblData").DataTable().ajax.reload();
                        } else {
                            $('#message').removeClass().addClass('error').html(err_in_process + res.error).show();
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#message').removeClass().addClass('error').html(err_in_process + error).show();
                    }
                });
            });

            // Attach click handler directly to CCD button
            $(document).off("click", "#btnCCD").on("click", "#btnCCD", function () {
                $.ajax({
                    url: '/Payroll/ExportExcessLeaveEncashCCD',
                    type: 'POST',
                    data: {
                        fiscalYear: $("#FiscalYearFilter").val(),
                        period: 1,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (res) {
                        if (res.status === "success") {
                            // Create download link dynamically
                            var link = document.createElement('a');
                            link.href = 'data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,' + res.fileContent;
                            link.download = res.fileName;
                            link.click();
                            $('#message').removeClass().addClass('success').html(msg_data_exported_success).show();
                            $("#tblData").DataTable().ajax.reload();
                        } else {
                            $('#message').removeClass().addClass('error').html(err_in_process + res.error).show();
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#message').removeClass().addClass('error').html(err_in_process + error).show();
                    }
                });
            });
        </script>
    }
}

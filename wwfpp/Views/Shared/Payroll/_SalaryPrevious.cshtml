@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model List<wwfpp.Models.Payroll.SalaryPreviousViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Employee Salary Previous";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Payroll/SalaryPrevious")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")
<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="row">
    <div class="col-lg-3"><label class="col-lg-12 col-form-label-lg">Employee Status: &nbsp;</label></div>
    <div class="col-lg-9">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, new { @class = "form-select", style = "width:150px;" })
    </div>
</div>
<div class="p-0 bg-white rounded mb-3">
    <div class="row align-items-center">
        <div class="col-auto ms-auto">
            @Html.Raw(ViewBag.ViewButtons)
        </div>
    </div>
</div>
@if (Model == null)
{
    <div id="message_header"><p class="note">No record(s) found.</p></div>
}
else
{
    <!-- DataTable -->
    <div class="form-group p-2">
        @Html.AntiForgeryToken()
        <table id="tblData" class="display compact nowrap" style="width:100%">
            <thead>
                <tr style="background-color:silver; height:40px;">
                    <th class="text-center" style="width:1%;"><input type="checkbox" id="selectAll"></th>
                    <th>Employee</th>
                    <th>Period</th>
                    <th>Salary</th>
                    <th>PF Addition</th>

                    <th>Allowance</th>
                    <th>Dashain Bonus</th>
                    <th>PF deduction</th>

                    <th>CIT deduction</th>

                    <th>Income Tax</th>
                    <th>Action</th>
                </tr>
            </thead>
        </table>
    </div>
    @await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

    @section Scripts {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            var selectedIds = new Set();
            var table;
            $(document).ready(function () 
            {
                GetAllData(ilaka, "id", [
                    { data: "employee", name: "employee", autoWidth: false },
                    {
                        data: "sal_year",
                        name: "sal_year",
                        autoWidth: false,
                        render: function (data, type, row) {
                            // Ensure month is numeric (e.g., 1–12)
                            return moment(`${row.sal_year}-${row.sal_month}`, "YYYY-M").format("MMM YYYY");
                        }
                    },
                    { data: "basicsalary", name: "t_basic_salary", autoWidth: false },
                    { data: "pfaddition", name: "t_pf", autoWidth: false },
                    { data: "allowance", name: "t_allow", autoWidth: false },
                    { data: "dashainbonus", name: "t_dashain", autoWidth: false },
                    { data: "pfdeduction", name: "t_pf_d", autoWidth: false },
                    { data: "citdeduction", name: "t_cit_d", autoWidth: false },
                    { data: "taxdeduction", name: "t_tax", autoWidth: false }
                    ],
                    {
                        FilterValue1: "EmployeeStatusFilter"
                    }
                   );
                $(document).on("click", "#tblData .button", function () { ViewData($(this).data("id")) });
                $(document).off('click', '#btnC').on('click', '#btnC', function () { modalCloseCancel($(this)); });
            });
        </script>

    }
}



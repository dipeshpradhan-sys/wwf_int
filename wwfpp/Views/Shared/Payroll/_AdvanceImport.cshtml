@{
    short advYear = @ViewBag.adv_year;
    short advMonth = @ViewBag.adv_month;
    string advMonthName = @ViewBag.advMonthName;
}
<partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
<label class="col-lg-12 col-form-label-lg">Year: @ViewBag.adv_year @Html.Hidden("adv_year", advYear)</label>
<label class="col-lg-12 col-form-label-lg">Month: @ViewBag.advMonthName @Html.Hidden("adv_month", advMonth)</label>
@if (ViewBag.blnShow == "false")
{
    <div class="row"><span id="blnShow" class="normal red">The salary has already been processed so that import action can not be performed</span></div>
}
else
{
    <div class="form-group row p-1">
        <label class="col-lg-12 col-form-label-lg">Select CSV file (*.csv)<span class="text-danger">*</span>&nbsp;</label>
        <div class="col-lg-12">
            @Html.TextBox("file", "", new { type = "file" })
        </div>
    </div>
}

@if (ViewBag.blnShow == "true" && ViewBag.epern == "true")
{
    <script>renderModalButtons("modal-button-list", "Upload");</script>
} else
{
    <script>renderModalCloseButton("modal-button-list");</script>
}
<script>
    $(document).off("click", "#btnSave").on("click", "#btnSave", function() {
        var btn = $(this);
        if (btn.text().trim() === "Upload") {
            if ($("#file").val() === "") {
                showError('Advance Import file is required.', 'modal-message'); return false;
            }
            submitSaveUpdateUpload("/Payroll/AdvanceImport");
        }
    });
    $(document).off("click", "#btnC").on("click", "#btnC", function() {
        $('#tblData').DataTable().ajax.reload();
        var modal = bootstrap.Modal.getInstance(document.getElementById("ModalID")); modal.hide();
    });
</script>
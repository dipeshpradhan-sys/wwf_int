@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Salary Pay Slip";
    var Page_Tips = "Note: <br/> √ Pay slip not blocked for selected period <br/> × Pay slip blocked for selected period";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}

@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<div class="d-flex align-items-center">
    <label class="me-2">Status:</label>
    @Html.DropDownList("StatusFilter", (SelectList)ViewBag.StatusFilter,
          new { @class = "form-select me-4", style = "width:150px;" })
    <label class="me-2">Year:</label>
    @Html.DropDownList("YearFilter", (SelectList)ViewBag.YearDropDown,
          new { @class = "form-select me-4", style = "width:150px;" })

    <label class="me-2">Month:</label>
    @Html.DropDownList("MonthFilter", (SelectList)ViewBag.MonthDropDown,
          new { @class = "form-select me-4", style = "width:150px;" })
</div>

@if (ViewBag.epern == "true")
{
    <div class="p-0 bg-white rounded mb-3">
        <div class="row align-items-center mt-3">
            <div class="col-sm-9 d-flex align-items-center">
                <label for="txtMessage" class="me-2">Message:</label>
                @Html.TextBox("txtMessage", "", new { @class = "form-control" })
            </div>
            <div class="col-sm-3 d-flex justify-content-end">
                <button type="button" id="btnSend" class="button btn-primary">Send</button>
                <button type="button" id="btnPreview" class="button bg-sky">Preview</button>
            </div>
        </div>
    </div>
}
@await Html.PartialAsync("_SharedModal", new wwfpp.Models.ModalViewModel { ModalId = "ModalID", DialogClass = "modal-lg", BodyId = "ModalBody", })

<div class="form-group p-2">
    @Html.AntiForgeryToken()
    <table id="tblData" class="display compact nowrap" style="width:100%">
        <thead>
            <tr style="background-color:silver; height:40px;">
                <th width="1%"><input type="checkbox" id="selectAll"></th>
                <th width="1%"></th>
                <th>Employee</th>
                <th>Employee ID</th>
                <th>Email</th>
            </tr>
        </thead>
    </table>
</div>

@section scripts
{
    <script>
        var ilaka = "/Payroll/PaySlipSend";
        var selectedIds = new Set();
        var hideviewaction = "yes";
        var table;
        $(document).ready(function ()
        {
           GetAllData(ilaka, "emp_id", [
                { data: "blockedicon", name: "blockedicon", autoWidth: false, render: function (data, type, row) {return data ;}},
                { data: "fullname", name: "fullname", autoWidth: false, render: function (data, type, row,meta) {return data ;}},
                { data: "emp_code", name: "emp_code", autoWidth: false, render: function(data, type, row, meta) {return data ;}},
                { data: "e_mail", name: "e_mail", autoWidth: false, render: function(data, type, row, meta) {return data ;}}
            ],
            {
                Status: "StatusFilter",
                Year: "YearFilter",
                Month: "MonthFilter"
            });
            $(document).one('init.dt', '#tblData', function () {table.page.len(-1).draw();})/** Wait for first draw to complete before changing page length*/
            $('#tblData_filter').hide();
            $('#tblData_length').hide();
        });

        function collectExtraFields() {
            var extraSettings = [];
            $("#tblData tbody tr").each(function () {
                var row = $(this);
                var id = row.find("input.row-checkbox:checked").val();
                if (selectedIds.has(id)) {
                    extraSettings.push({
                        emp_id: parseInt(id, 10),
                    });
                }
            });
            return extraSettings;
        }
        $("#StatusFilter").off("change").on("change", function () { const statusV = $(this).val(); if (!statusV) { return; } const $myButton = $("#btnSave"); if ($myButton.length) { if (statusV === "A") { $myButton.show(); $('#tblData_length').hide(); table.page.len(-1).draw(); } else { $myButton.hide(); $('#tblData_length').show(); table.page.len(10).draw(); } } table.draw(); });

        $(document).off("click", "#btnSend").on("click", "#btnSend", function () { 
            hideMessage(); 
            if (doAnyCheckboxSelected(msg_select_at_least_one_checkbox) == false) { return false; }
            if (confirm(msg_are_you_sure_to_perform_this_action)) 
            {
                var message = $("#txtMessage").val();
                var year = $("#YearFilter").val() || 0;
                var month = $("#MonthFilter").val() || 0;
                var payload = { mode: "submit", year: year, month: month, message: message };
                var ids = Array.from(selectedIds); // e.g. ["12","45","78"]
                if (ids.length > 0) {
                    payload.selectedIds = [...selectedIds];
                }
                if (typeof collectExtraFields === "function") {
                    var extraFields = collectExtraFields();
                    if (extraFields && extraFields.length > 0) {
                        payload.Fields = extraFields;
                    }
                }
                $.ajax({
                    type: "POST",
                    url: ilaka + "Submit",
                    data: JSON.stringify(payload),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json", 
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function (data) {
                        if (data.status) {  
                            if (data.status === "success") { showSuccess(data.message); } else { showError("Error: " + data.message); }
                            $('#tblData').DataTable().ajax.reload(null, false);
                        } else {
                            showError("Error: " + data.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        showError("Request failed: " + error);
                    }
                });

            }
        });

        $('#btnPreview').on('click', function () {
             hideMessage();
             var selected = Array.from(selectedIds);
             if (selected.length === 0) {
                 showError(msg_select_empoloyee_payslip);
                 return;
             }

             var year = $('#YearFilter').val();
             var month = $('#MonthFilter').val();

             $.ajax({
                 type: "POST",
                 url: "/Payroll/PaySlipPreview",
                 contentType: "application/json",
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                 data: JSON.stringify({ SelectedIds: selected, Year: year, Month: month }),
                 success: function (html) {
                    $("#ModalID .modal-title").text("Pay Slip Preview");
                     $("#globalModalFooter").hide();
                     $('#ModalBody').html(html);
                     $('#ModalID').modal('show');
                 },
                 error: function () {
                     showError("An error occurred while loading the preview.");
                 }
             });
         });
    </script>
}
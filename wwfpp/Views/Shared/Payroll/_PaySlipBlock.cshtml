@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Block Pay Slip";
    var Page_Tips = "<b>Block Pay Slip from Viewing:</b><br/>Tick the check box for employee and select the period and click Save.<br/><br/><b>Unblock Pay Slip from Viewing:</b><br/>Untick the check box for employee and click Save";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle;
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);
    /*success|fail|error'*/
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());
}
@Html.AntiForgeryToken()
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>

<div class="row">
    <div class="col-lg-2"><label class="col-lg-12 col-form-label-lg">Employee Status : &nbsp;</label></div>
    <div class="col-lg-10">
        @Html.DropDownList("EmployeeStatusFilter", (SelectList)ViewBag.EmployeeStatusFilter, new { @class = "form-select", style = "width:300px;" })
    </div>
</div>

<div class="form-group p-2">
    <table id="tblData" class="display compact nowrap" style="width:100%">
        <thead>
            <tr style="background-color:silver; height:40px;">
                <th class="text-center" >
                    <input type="checkbox" id="selectAll">
                </th>
                <th colspan="5" class="text-center">Employee</th>
                <th colspan="2" class="text-center">Block pay slip for</th>
            </tr>
            <tr style="background-color:silver; height:40px;">
                <th width="1%"></th>
                <th width="4%">Blocked?</th>
                <th width="35%">Name</th>
                <th width="10%">Gender</th>
                <th width="15%">Join Date</th>
                <th width="15%">End Date</th>
                <th width="10%">Year</th>
                <th width="10%">Month</th>
            </tr>
        </thead>
        <tbody>

        </tbody>
    </table>
</div>
<div id="message_header">@Html.Raw(ShowMsg)</div>
@if (ViewBag.epern == "true")
{
    <div class="form-group row p-1">
        <label class="col-sm-4 col-form-label">&nbsp;</label>
        <div class="col-sm-8">
            <button type="reset" name="btnReset" id="btnReset" class="button btn-secondary">Reset</button>
            <button type="button" name="btnSave" id="btnSave" class="button btn-primary">Save</button>
        </div>
    </div>
}
<div id="msTemplate" style="display:none;">@Html.DropDownList("sal_year", (SelectList)ViewBag.YearDropDown, "--Select--", new { @class = "form-control", style = "width:90px;" })</div>
<div id="psTemplate" style="display:none;">@Html.DropDownList("sal_month", (SelectList)ViewBag.MonthDropDown, "--Select--", new { @class = "form-control", style = "width:100px;" })</div>

@section scripts
{
    <script>
        var ilaka = "/Payroll/PaySlipBlock";
        var selectedIds = new Set();
        var hideviewaction = "yes";
        var table;
        $(document).ready(function() {
            GetAllData(ilaka, "emp_id", [
                { data: "block_status", name: "block_status", autoWidth: false, render: function(data, type, row) { return '<span style="white-space:normal;">' + data + '</span>'; } },
                { data: "employee", name: "employee", autoWidth: false, render: function(data, type, row) { return '<span style="white-space:normal;">' + data + '</span>'; } },
                { data: "gender", name: "gender", autoWidth: false, render: function(data, type, row) { return '<span style="white-space:normal;">' + data + '</span>'; } },
                { data: "join_date", name: "join_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                { data: "end_date", name: "end_date", autoWidth: false, render: function(data, type, row) { if (type === 'display' || type === 'filter') { return moment(data).format(my_format); } return data; } },
                { data: "sal_year", name: "sal_year", autoWidth: false, render: function(data, type, row, meta) { var ctrlName = "sal_year" + meta.row; var $select = $("#msTemplate select").clone(); $select.attr("id", ctrlName).attr("name", ctrlName); var val = data != null ? data.toString().trim() : ""; $select.find("option:selected").prop("selected", false); $select.find("option").each(function() { if ($(this).val() === val) { $(this).attr("selected", "selected"); } }); return $select.prop("outerHTML"); } },
                { data: "sal_month",name: "sal_month",autoWidth: false,render: function(data, type, row, meta) {var ctrlName = "sal_month" + meta.row;var $select = $("#psTemplate select").clone();$select.attr("id", ctrlName).attr("name", ctrlName);var val = data != null ? data.toString().trim() : ""; $select.find("option").removeAttr("selected");$select.find("option[value='" + val + "']").attr("selected", "selected"); return $select.prop("outerHTML");} }
            ],
                {
                    FilterValue: "EmployeeStatusFilter"
                });
            $(document).one('init.dt', '#tblData', function() { table.page.len(-1).draw(); })
            $('#tblData_filter').hide();
            $('#tblData_length').hide();
        });

        function collectExtraFields() {
            var extraSettings = [];
            $("#tblData tbody tr").each(function() {
                var row = $(this);
                var id = row.find("input.row-checkbox:checked").val();
                if (selectedIds.has(id)) {
                    extraSettings.push({
                        id: "",
                        emp_id: parseInt(id, 10),
                        sal_year: row.find("select[name^='sal_year']").val(),
                        sal_month: row.find("select[name^='sal_month']").val()
                    });
                }
            });
            return extraSettings;
        }
        $(document).off("click", "#btnSave").on("click", "#btnSave", function () { $("#mode").val("update"); updateDataWithoutJSON(ilaka + "Save"); });
        $("#EmployeeStatusFilter").off("change").on("change", function() { const statusV = $(this).val(); if (!statusV) { return; } const $myButton = $("#btnSave"); if ($myButton.length) { if (statusV === "A") { $myButton.show(); $('#tblData_length').hide(); table.page.len(-1).draw(); } else { $myButton.hide(); $('#tblData_length').show(); table.page.len(10).draw(); } } table.draw(); });
    </script>
}
@model wwfpp.Models.Admin.UserLoginHistoryViewModel
@{
    string mode = ViewBag.mode;
}
<!-- (A) HTML DIALOG BOX -->
    <div class="form-group row p-1">

        <label class="col-lg-12 col-form-label-lg">Employee</label>
        <div class="col-lg-12">@Model.fullname</div>
        
        <label class="col-lg-12 col-form-label-lg">User Name</label>
        <div class="col-lg-12">@Model.username</div>
        
        <label class="col-lg-12 col-form-label-lg">User Level</label>
        <div class="col-lg-12">@Model.level_name</div>
        
        <label class="col-lg-12 col-form-label-lg">In</label>
        <div class="col-lg-12">@Model.in_date</div>
        
        <label class="col-lg-12 col-form-label-lg">Out</label>
        <div class="col-lg-12">@Model.out_date</div>
        
        <label class="col-lg-12 col-form-label-lg">Ip Address</label>
        <div class="col-lg-12">@Model.ip</div>

        <label class="col-lg-12 col-form-label-lg">User Agent</label>
        <div class="col-lg-12">@Model.user_agent</div>

    </div>

    <script>renderModalCloseButton("modal-button-list")</script>

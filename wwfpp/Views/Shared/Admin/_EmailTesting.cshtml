@using Microsoft.AspNetCore.Http;
@inject IHttpContextAccessor HttpContextAccessor;
@model wwfpp.Models.Admin.EmailTestingViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var PageTitle = "Email Testing";
    var Page_Tips = "";  //Tool tip message on right side
    var msg_please_wait = "";
    var Page_Mode = PageTitle; 
    ViewData["Title"] = "| " + PageTitle;
    var Help_Tips = GblUtilities.HelpTips(Page_Tips);    
    string ShowMsg = GblUtilities.MsgDisplay(Context.Request.Query["msg"].ToString());/*success|fail|error'*/
}
@Html.AntiForgeryToken()
@Html.Hidden("ilaka", "/Admin/EmailTesting")
<h2 class="titlebig"><span name="header" id="header">@Page_Mode</span> @Html.Raw(Help_Tips)</h2>
@Html.Hidden("mode", "")
@Html.Hidden("Id", "")

<div id="message_header"><p id="loading" class="loading displaynone">@msg_please_wait</p></div>
<div id="message_header">@Html.Raw(ShowMsg)</div>

<!-- Controls row under the header -->

<!-- DataTable -->
@if (Model == null)
{
    <div id="message_header"><p class="note">Nothing to Show</p></div>
}
else
{
    <div class="container mt-2 ms-lg-0">
        <div class="row">
            <!-- Left Form -->
            <div class="col-md-8">
                    <partial name="_ConstantValues" view-data='new ViewDataDictionary(ViewData) { { "NoteKey", "RequiredField" } }' />
                    <!-- Fund Source -->
                    <div class="row mb-2">
                        <div class="col-sm-3 font-weight-bold">Email (To):<span class="text-danger">*</span></div>
                        <div class="col-sm-6">
                        @Html.TextBox("to_email", "info@efourcore.com.np", new { @class = "form-control", maxlength = "100" })
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3 font-weight-bold">Email (CC):</div>
                        <div class="col-sm-6">
                        @Html.TextBox("cc_email", "", new { @class = "form-control", maxlength = "100" })
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3 font-weight-bold">Subject:<span class="text-danger">*</span></div>
                        <div class="col-sm-6">
                        @Html.TextBox("subject", "Nice subject goes here", new { @class = "form-control", maxlength = "200" })
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-3 font-weight-bold">Message:<span class="text-danger">*</span></div>
                        <div class="col-sm-6">
                        @Html.TextArea("messages", "Nice message goes here", new { @class = "form-control", rows = "4", cols = "50", maxlength = "50" })
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="row mb-2">
                        <div class="col-sm-3">&nbsp;</div>
                        <div class="col-sm-6">
                            @Html.Raw(ViewBag.ViewButtons)
                        </div>
                    </div>

            </div>
            <!-- Right Form -->
        </div>
    </div>
    @section scripts 
    {
        <script>
            var ilaka = document.getElementById('ilaka').value;
            $(document).ready(function () 
            {
                $(document).off("click", "#btnSend").on("click", "#btnSend", function () {
                    var btn = $(this);
                    if ( checkInput( 'email', 'to_email', 'To Email required.', '') == false ) {return false;}
                    if ( checkInput( 'txt', 'subject', 'Subject is required.', '') == false ) {return false;}
                    if ( checkInput( 'txt', 'messages', 'Message is required.', '') == false ) {return false;}
                    submitSendEmail(ilaka);
                });
            });
        </script>
    }
}
